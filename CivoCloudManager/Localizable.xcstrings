    "Civo refused to create the load balancer, so nothing was created. Check the name, network, backends and your quota in the Civo dashboard." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo refused to create the load balancer, so nothing was created. Check the name, network, backends and your quota in the Civo dashboard."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo hat das Erstellen des Load Balancers abgelehnt, daher wurde nichts erstellt. Prüfen Sie Name, Netzwerk, Backends und Ihr Kontingent im Civo-Dashboard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
