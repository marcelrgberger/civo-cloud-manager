    "A reserved IP address can incur running costs, also while it is not assigned." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A reserved IP address can incur running costs, also while it is not assigned."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine reservierte IP-Adresse kann laufende Kosten verursachen, auch wenn sie nicht zugewiesen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una dirección IP reservada puede generar costes continuos, incluso si no está asignada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une adresse IP réservée peut entraîner des coûts récurrents, même lorsqu'elle n'est pas attribuée."
          }
        },
        "it" : {
          "stringUnit" : {
