    "Civo reports no initial user or password for this instance." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo reports no initial user or password for this instance."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo meldet für diese Instanz keinen Anfangsbenutzer und kein Anfangspasswort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo no indica ningún usuario ni contraseña inicial para esta instancia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo n’indique aucun utilisateur ni mot de passe initial pour cette instance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
