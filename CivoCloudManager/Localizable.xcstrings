    "A cluster keeps at least one node pool, so nothing was sent." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cluster keeps at least one node pool, so nothing was sent."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Cluster behält mindestens einen Node-Pool, daher wurde nichts gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un clúster conserva al menos un grupo de nodos, así que no se envió nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un cluster conserve au moins un pool de nœuds, rien n'a donc été envoyé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un cluster mantiene almeno un pool di nodi, quindi non è stato inviato nulla."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een cluster houdt minstens één node-pool, daarom is er niets verzonden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klaster zachowuje co najmniej jedną pulę węzłów, więc nic nie zostało wysłane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um cluster mantém pelo menos um pool de nós, por isso nada foi enviado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集群至少保留一个节点池，因此未发送任何内容。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラスタには少なくとも 1 つのノードプールが残るため、何も送信されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클러스터에는 노드 풀이 하나 이상 남아야 하므로 아무것도 전송되지 않았습니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتفظ العنقود بمجموعة عقد واحدة على الأقل، لذلك لم يُرسَل أي شيء."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्लस्टर में कम से कम एक नोड पूल रहता है, इसलिए कुछ भी नहीं भेजा गया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klaster mempertahankan setidaknya satu kolam node, jadi tidak ada yang dikirim."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir küme en az bir düğüm havuzunu korur, bu nedenle hiçbir şey gönderilmedi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В кластере остаётся как минимум один пул узлов, поэтому ничего не отправлено."
          }
        }
      }
    },
