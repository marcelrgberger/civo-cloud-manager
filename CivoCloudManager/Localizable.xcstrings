    "The region changed, so the instance action was cancelled. Nothing was sent." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The region changed, so the instance action was cancelled. Nothing was sent."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّرت المنطقة، لذلك أُلغي إجراء المثيل. لم يُرسَل أي شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Region hat sich geändert, daher wurde die Aktion für die Instanz abgebrochen. Es wurde nichts gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La región ha cambiado, así que se canceló la acción de la instancia. No se envió nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La région a changé, l'action sur l'instance a donc été annulée. Rien n'a été envoyé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्षेत्र बदल गया, इसलिए इंस्टेंस कार्रवाई रद्द कर दी गई। कुछ भी नहीं भेजा गया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wilayah berubah, jadi tindakan instance dibatalkan. Tidak ada yang dikirim."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La regione è cambiata, quindi l'azione sull'istanza è stata annullata. Non è stato inviato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リージョンが変更されたため、インスタンスの操作をキャンセルしました。何も送信されていません。"
          }
        },
        "ko" : {
