    "Civo accepted the firewall change, but its answer could not be read. Check which firewall the instance uses now." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo accepted the firewall change, but its answer could not be read. Check which firewall the instance uses now."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo hat den Firewall-Wechsel angenommen, aber die Antwort konnte nicht gelesen werden. Prüfe, welche Firewall die Instanz jetzt verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo aceptó el cambio de firewall, pero no se pudo leer su respuesta. Comprueba qué firewall usa ahora la instancia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo a accepté le changement de pare-feu, mais sa réponse n'a pas pu être lue. Vérifiez quel pare-feu l'instance utilise maintenant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo ha accettato il cambio di firewall, ma non è stato possibile leggere la risposta. Controlla quale firewall usa ora l'istanza."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo heeft de firewallwijziging geaccepteerd, maar het antwoord kon niet worden gelezen. Controleer welke firewall de instantie nu gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo przyjęło zmianę zapory sieciowej, ale nie udało się odczytać odpowiedzi. Sprawdź, której zapory instancja używa teraz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Civo aceitou a alteração do firewall, mas não foi possível ler a resposta. Verifique que firewall a instância usa agora."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo 已接受防火墙更改，但无法读取其响应。请检查该实例现在使用的防火墙。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo はファイアウォールの変更を受け付けましたが、応答を読み取れませんでした。インスタンスが現在使用しているファイアウォールを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo가 방화벽 변경을 수락했지만 응답을 읽을 수 없습니다. 인스턴스가 지금 사용하는 방화벽을 확인하세요."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قبلت Civo تغيير جدار الحماية، لكن تعذّرت قراءة ردّها. تحقّق من جدار الحماية الذي يستخدمه المثيل الآن."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo ने फ़ायरवॉल बदलाव स्वीकार कर लिया, लेकिन उसका जवाब पढ़ा नहीं जा सका। जाँचें कि इंस्टेंस अब कौन सा फ़ायरवॉल उपयोग करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo menerima perubahan firewall, tetapi jawabannya tidak dapat dibaca. Periksa firewall mana yang digunakan instance sekarang."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo güvenlik duvarı değişikliğini kabul etti, ancak yanıtı okunamadı. Sunucunun şimdi hangi güvenlik duvarını kullandığını kontrol edin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo принял смену брандмауэра, но его ответ не удалось прочитать. Проверьте, какой брандмауэр инстанс использует сейчас."
          }
        }
      }
    },
    "Enter at least one tag. To remove all tags, use Remove All Tags." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter at least one tag. To remove all tags, use Remove All Tags."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib mindestens einen Tag ein. Um alle Tags zu entfernen, verwende Alle Tags entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce al menos una etiqueta. Para eliminar todas las etiquetas, usa Eliminar todas las etiquetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez au moins un tag. Pour supprimer tous les tags, utilisez Supprimer tous les tags."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci almeno un tag. Per rimuovere tutti i tag, usa Rimuovi tutti i tag."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer minstens één tag in. Gebruik Alle tags verwijderen om alle tags te verwijderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz co najmniej jeden tag. Aby usunąć wszystkie tagi, użyj Usuń wszystkie tagi."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduza pelo menos uma tag. Para remover todas as tags, use Remover todas as tags."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请至少输入一个标签。要移除所有标签，请使用'移除所有标签'。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タグを1つ以上入力してください。すべてのタグを削除するには、'すべてのタグを削除'を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "태그를 하나 이상 입력하세요. 모든 태그를 제거하려면 '모든 태그 제거'를 사용하세요."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل وسمًا واحدًا على الأقل. لإزالة جميع الوسوم، استخدم 'إزالة جميع الوسوم'."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कम से कम एक टैग दर्ज करें। सभी टैग हटाने के लिए 'सभी टैग हटाएँ' का उपयोग करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukkan setidaknya satu tag. Untuk menghapus semua tag, gunakan Hapus Semua Tag."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En az bir etiket girin. Tüm etiketleri kaldırmak için Tüm Etiketleri Kaldır'ı kullanın."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите хотя бы один тег. Чтобы удалить все теги, используйте 'Удалить все теги'."
          }
        }
      }
    },
    "Tags cannot contain spaces: %@. Use a hyphen instead." : {
      "comment" : "Tag input error; %@ lists the entered tags that contain spaces",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tags cannot contain spaces: %@. Use a hyphen instead."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tags dürfen keine Leerzeichen enthalten: %@. Verwende stattdessen einen Bindestrich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las etiquetas no pueden contener espacios: %@. Usa un guion en su lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tags ne peuvent pas contenir d'espaces : %@. Utilisez plutôt un trait d'union."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tag non possono contenere spazi: %@. Usa invece un trattino."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tags mogen geen spaties bevatten: %@. Gebruik in plaats daarvan een koppelteken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagi nie mogą zawierać spacji: %@. Użyj zamiast tego łącznika."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
