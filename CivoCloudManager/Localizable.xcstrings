          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تُدرج Civo مجموعات عقد هذا العنقود، لذلك لم يُرسَل أي شيء."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo ने इस क्लस्टर के नोड पूल सूचीबद्ध नहीं किए, इसलिए कुछ भी नहीं भेजा गया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo tidak mencantumkan kolam node klaster ini, jadi tidak ada yang dikirim."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo bu kümenin düğüm havuzlarını listelemedi, bu nedenle hiçbir şey gönderilmedi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo не перечислил пулы узлов этого кластера, поэтому ничего не отправлено."
          }
        }
      }
    },
    "Civo did not report the size or node count of pool %@, so the pools cannot be sent unchanged and nothing was sent." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo did not report the size or node count of pool %@, so the pools cannot be sent unchanged and nothing was sent."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo hat die Größe oder Knotenanzahl von Pool %@ nicht gemeldet, daher können die Pools nicht unverändert gesendet werden und es wurde nichts gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo no informó el tamaño ni el número de nodos del grupo %@, así que los grupos no pueden enviarse sin cambios y no se envió nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo n'a pas indiqué la taille ou le nombre de nœuds du pool %@ ; les pools ne peuvent donc pas être envoyés inchangés et rien n'a été envoyé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo non ha indicato la dimensione o il numero di nodi del pool %@, quindi i pool non possono essere inviati invariati e non è stato inviato nulla."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo heeft de grootte of het aantal nodes van pool %@ niet gemeld, daarom kunnen de pools niet ongewijzigd worden verzonden en is er niets verzonden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo nie podało rozmiaru ani liczby węzłów puli %@, więc pul nie można wysłać bez zmian i nic nie zostało wysłane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Civo não informou o tamanho ou o número de nós do pool %@, por isso os pools não podem ser enviados inalterados e nada foi enviado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo 未报告节点池 %@ 的规格或节点数，因此无法原样发送节点池，未发送任何内容。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo がプール %@ のサイズまたはノード数を返さなかったため、プールを変更せずに送信できず、何も送信されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo가 풀 %@의 크기나 노드 수를 보고하지 않아 풀을 변경 없이 보낼 수 없으므로 아무것도 전송되지 않았습니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تُبلغ Civo عن حجم المجموعة %@ أو عدد عقدها، لذلك لا يمكن إرسال المجموعات دون تغيير ولم يُرسَل أي شيء."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo ने पूल %@ का आकार या नोड संख्या नहीं बताई, इसलिए पूल बिना बदलाव के नहीं भेजे जा सकते और कुछ भी नहीं भेजा गया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo tidak melaporkan ukuran atau jumlah node kolam %@, jadi kolam tidak dapat dikirim tanpa perubahan dan tidak ada yang dikirim."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo %@ havuzunun boyutunu veya düğüm sayısını bildirmedi, bu nedenle havuzlar değiştirilmeden gönderilemez ve hiçbir şey gönderilmedi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo не сообщил размер или число узлов пула %@, поэтому пулы нельзя отправить без изменений, и ничего не отправлено."
          }
        }
      }
    },
    "Civo no longer offers the size %@, so nothing was sent." : {
