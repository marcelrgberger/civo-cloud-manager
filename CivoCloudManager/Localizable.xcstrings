        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Civo aceitou o pedido para substituir o nó \"%@\" em \"%@\". A substituição decorre do lado da Civo e ainda não terminou; o estado mostrado aqui é atualizado quando atualizar."
          }
