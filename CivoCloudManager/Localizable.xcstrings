          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标签不能包含空格：%@。请改用连字符。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タグにスペースは使用できません: %@。代わりにハイフンを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "태그에는 공백을 사용할 수 없습니다: %@. 대신 하이픈을 사용하세요."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن أن تحتوي الوسوم على مسافات: %@. استخدم شرطة بدلاً من ذلك."
          }
        },
        "hi" : {
