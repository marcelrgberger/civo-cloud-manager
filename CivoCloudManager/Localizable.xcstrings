          }
        }
      },
      "extractionState" : "manual"
    },
    "The 'Credentials' section in the sidebar (under Storage & Data) manages Object Store credentials." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The 'Credentials' section in the sidebar (under Storage & Data) manages Object Store credentials."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Bereich „Zugangsdaten“ in der Seitenleiste (unter Speicher & Daten) verwaltet Object Store Zugangsdaten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sección \"Credenciales\" en la barra lateral (en Almacenamiento y datos) gestiona las credenciales de almacenes de objetos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La section « Identifiants » de la barre latérale (Stockage & Données) gère les identifiants de stockage objet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sezione \"Credenziali\" nella barra laterale (in Storage & Data) gestisce le credenziali degli Object Store."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het gedeelte 'Inloggegevens' in de zijbalk (onder Opslag & Data) beheert de object store-inloggegevens."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekcja „Dane uwierzytelniające” w pasku bocznym (pod Magazyn i dane) zarządza danymi Object Store."
          }
        },
        "pt" : {
