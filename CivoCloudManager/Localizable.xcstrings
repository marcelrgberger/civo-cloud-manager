          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это завершит сеанс консоли этого инстанса в Civo, включая консоль, открытую в панели управления Civo."
          }
        }
      }
    },
    "Log in with a password of a user on the instance, for example the initial password. Copy and paste are not available in the console." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log in with a password of a user on the instance, for example the initial password. Copy and paste are not available in the console."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melden Sie sich mit dem Passwort eines Benutzers der Instanz an, zum Beispiel mit dem Initialpasswort. Kopieren und Einfügen sind in der Konsole nicht verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión con la contraseña de un usuario de la instancia, por ejemplo la contraseña inicial. Copiar y pegar no están disponibles en la consola."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous avec le mot de passe d’un utilisateur de l’instance, par exemple le mot de passe initial. Le copier-coller n’est pas disponible dans la console."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi con la password di un utente dell’istanza, ad esempio la password iniziale. Copia e incolla non sono disponibili nella console."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log in met het wachtwoord van een gebruiker op de instance, bijvoorbeeld het initiële wachtwoord. Kopiëren en plakken zijn niet beschikbaar in de console."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaloguj się hasłem użytkownika instancji, na przykład hasłem początkowym. Kopiowanie i wklejanie nie są dostępne w konsoli."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicie sessão com a palavra-passe de um utilizador da instância, por exemplo a palavra-passe inicial. Copiar e colar não estão disponíveis na consola."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请使用实例上某个用户的密码登录，例如初始密码。控制台中无法复制和粘贴。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インスタンス上のユーザーのパスワード（例：初期パスワード）でログインしてください。コンソールではコピー＆ペーストは使用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인스턴스 사용자의 비밀번호(예: 초기 비밀번호)로 로그인하세요. 콘솔에서는 복사 및 붙여넣기를 사용할 수 없습니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل الدخول بكلمة مرور أحد مستخدمي المثيل، مثل كلمة المرور الأولية. النسخ واللصق غير متاحين في وحدة التحكم."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंस्टेंस के किसी उपयोगकर्ता के पासवर्ड से लॉग इन करें, जैसे प्रारंभिक पासवर्ड। कंसोल में कॉपी और पेस्ट उपलब्ध नहीं हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masuk dengan kata sandi pengguna di instans, misalnya kata sandi awal. Salin dan tempel tidak tersedia di konsol."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Örnekteki bir kullanıcının parolasıyla, örneğin ilk parolayla oturum açın. Konsolda kopyalama ve yapıştırma kullanılamaz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войдите с паролем пользователя инстанса, например с начальным паролем. Копирование и вставка в консоли недоступны."
          }
        }
      }
    },
