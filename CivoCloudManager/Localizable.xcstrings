    "The cluster is busy (status %@), so no node is replaced. Wait until it is active, then try again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The cluster is busy (status %@), so no node is replaced. Wait until it is active, then try again."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Cluster ist beschäftigt (Status %@), daher wird kein Knoten ersetzt. Warten Sie, bis er aktiv ist, und versuchen Sie es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El clúster está ocupado (estado %@), así que no se reemplaza ningún nodo. Espere a que esté activo y vuelva a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cluster est occupé (statut %@), aucun nœud n'est donc remplacé. Attendez qu'il soit actif, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il cluster è occupato (stato %@), quindi nessun nodo viene sostituito. Attendi che sia attivo, poi riprova."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het cluster is bezig (status %@), daarom wordt er geen node vervangen. Wacht tot het actief is en probeer het dan opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klaster jest zajęty (status %@), więc żaden węzeł nie zostanie wymieniony. Poczekaj, aż będzie aktywny, i spróbuj ponownie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cluster está ocupado (estado %@), por isso nenhum nó é substituído. Aguarde até que esteja ativo e tente novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集群正忙（状态 %@），因此不会替换任何节点。请等待其变为活动状态后重试。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラスタは処理中です（ステータス %@）。そのためノードは置き換えられません。アクティブになるまで待ってから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클러스터가 사용 중이므로(상태 %@) 노드를 교체하지 않습니다. 활성 상태가 될 때까지 기다린 후 다시 시도하세요."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
