    "The selected firewall is no longer in the network of this instance, so nothing was sent." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selected firewall is no longer in the network of this instance, so nothing was sent."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ausgewählte Firewall ist nicht mehr im Netzwerk dieser Instanz, daher wurde nichts gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El firewall seleccionado ya no está en la red de esta instancia, así que no se envió nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pare-feu sélectionné ne se trouve plus dans le réseau de cette instance, rien n'a donc été envoyé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il firewall selezionato non è più nella rete di questa istanza, quindi non è stato inviato nulla."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De geselecteerde firewall staat niet meer in het netwerk van deze instantie, daarom is er niets verzonden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybranej zapory sieciowej nie ma już w sieci tej instancji, więc nic nie zostało wysłane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O firewall selecionado já não está na rede desta instância, por isso nada foi enviado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选防火墙已不在此实例的网络中，因此未发送任何内容。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したファイアウォールはこのインスタンスのネットワークにもうないため、何も送信されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 방화벽이 더 이상 이 인스턴스의 네트워크에 없으므로 아무것도 전송되지 않았습니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يعد جدار الحماية المحدد موجودًا في شبكة هذا المثيل، لذلك لم يُرسَل أي شيء."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुना गया फ़ायरवॉल अब इस इंस्टेंस के नेटवर्क में नहीं है, इसलिए कुछ भी नहीं भेजा गया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firewall yang dipilih tidak lagi ada di jaringan instance ini, jadi tidak ada yang dikirim."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçilen güvenlik duvarı artık bu sunucunun ağında değil, bu nedenle hiçbir şey gönderilmedi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбранного брандмауэра больше нет в сети этого инстанса, поэтому ничего не отправлено."
          }
        }
      }
    },
