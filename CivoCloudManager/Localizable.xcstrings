        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conta ou a região mudou enquanto o pedido estava pendente. Volte à conta e à região que usou para verificar o resultado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
