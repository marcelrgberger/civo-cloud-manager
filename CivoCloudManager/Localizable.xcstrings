      }
    },
    "The region changed, so the node replacement was cancelled. Nothing was sent." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The region changed, so the node replacement was cancelled. Nothing was sent."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Region hat sich geändert, daher wurde das Ersetzen des Knotens abgebrochen. Es wurde nichts gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La región ha cambiado, así que se canceló el reemplazo del nodo. No se envió nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La région a changé, le remplacement du nœud a donc été annulé. Rien n'a été envoyé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La regione è cambiata, quindi la sostituzione del nodo è stata annullata. Non è stato inviato nulla."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De regio is gewijzigd, daarom is het vervangen van de node geannuleerd. Er is niets verzonden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Region się zmienił, więc wymiana węzła została anulowana. Nic nie zostało wysłane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A região mudou, por isso a substituição do nó foi cancelada. Nada foi enviado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "区域已更改，因此节点替换已取消。未发送任何内容。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リージョンが変更されたため、ノードの置き換えをキャンセルしました。何も送信されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "리전이 변경되어 노드 교체가 취소되었습니다. 아무것도 전송되지 않았습니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّرت المنطقة، لذلك أُلغي استبدال العقدة. لم يُرسَل أي شيء."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्षेत्र बदल गया, इसलिए नोड बदलना रद्द कर दिया गया। कुछ भी नहीं भेजा गया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wilayah berubah, jadi penggantian node dibatalkan. Tidak ada yang dikirim."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bölge değişti, bu nedenle düğüm değişimi iptal edildi. Hiçbir şey gönderilmedi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Регион изменился, поэтому замена узла отменена. Ничего не отправлено."
          }
        }
      }
    },
