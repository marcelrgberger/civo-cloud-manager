        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo इस इंस्टेंस के लिए कोई प्रारंभिक यूज़र या पासवर्ड नहीं बताता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo tidak melaporkan pengguna atau kata sandi awal untuk instans ini."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo bu örnek için ilk kullanıcı veya parola bildirmiyor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo не сообщает начального пользователя или пароль для этого экземпляра."
          }
        }
      }
    },
    "Shows the initial login reported by Civo. A password changed later on the instance is not shown here." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows the initial login reported by Civo. A password changed later on the instance is not shown here."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt die von Civo gemeldeten Anfangszugangsdaten. Ein später auf der Instanz geändertes Passwort wird hier nicht angezeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el inicio de sesión inicial indicado por Civo. Una contraseña cambiada después en la instancia no se muestra aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
