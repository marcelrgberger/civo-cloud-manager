    "The instance was deleted, but its saved credentials could not be removed." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The instance was deleted, but its saved credentials could not be removed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Instanz wurde gelöscht, aber ihre gespeicherten Zugangsdaten konnten nicht entfernt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La instancia se ha eliminado, pero no se han podido quitar sus credenciales guardadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
