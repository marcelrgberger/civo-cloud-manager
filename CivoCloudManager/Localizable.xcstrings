    "Resuming recreates the store with the same name and credentials, then restores all files." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Fortsetzen wird der Store mit demselben Namen und denselben Anmeldedaten neu erstellt und alle Dateien wiederhergestellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resuming recreates the store with the same name and credentials, then restores all files."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reanudar recrea el store con el mismo nombre y credenciales, luego restaura todos los archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reprise recrée le store avec les mêmes nom et identifiants, puis restaure tous les fichiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ripristino ricrea lo store con lo stesso nome e le stesse credenziali, quindi ripristina tutti i file."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hervatten maakt de store opnieuw aan met dezelfde naam en inloggegevens en herstelt alle bestanden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wznowienie odtwarza store z tą samą nazwą i poświadczeniami, a następnie przywraca wszystkie pliki."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retomar recria o store com o mesmo nome e credenciais, depois restaura todos os arquivos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复操作会以相同名称和凭据重新创建存储，并恢复所有文件。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再開すると、同じ名前と認証情報でストアが再作成され、すべてのファイルが復元されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재개하면 동일한 이름과 자격 증명으로 저장소를 다시 만들고 모든 파일을 복원합니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي الاستئناف إلى إعادة إنشاء المتجر بنفس الاسم وبيانات الاعتماد، ثم استعادة جميع الملفات."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फिर से शुरू करने पर वही नाम और क्रेडेंशियल्स के साथ स्टोर पुनः बनाया जाता है, फिर सभी फाइलें पुनर्स्थापित की जाती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melanjutkan akan membuat ulang toko dengan nama dan kredensial yang sama, lalu memulihkan semua berkas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devam ettirme, mağazayı aynı ad ve kimlik bilgileriyle yeniden oluşturur ve ardından tüm dosyaları geri yükler."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возобновление воссоздаёт хранилище с тем же именем и учётными данными, затем восстанавливает все файлы."
          }
        }
      }
