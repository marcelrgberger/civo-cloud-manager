    "After the trial, a one-time Full Access purchase unlocks the dashboard. The price is shown before purchase." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After the trial, a one-time Full Access purchase unlocks the dashboard. The price is shown before purchase."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach der Testphase schaltet ein einmaliger Kauf von Full Access das Dashboard frei. Der Preis wird vor dem Kauf angezeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de la prueba, una compra única de Full Access desbloquea el panel. El precio se muestra antes de comprar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après l’essai, un achat unique de Full Access déverrouille le tableau de bord. Le prix est affiché avant l’achat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo la prova, un acquisto una tantum di Full Access sblocca la dashboard. Il prezzo viene mostrato prima dell’acquisto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na de proefperiode ontgrendelt een eenmalige aankoop van Full Access het dashboard. De prijs wordt vóór aankoop getoond."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po okresie próbnym jednorazowy zakup Full Access odblokowuje panel. Cena jest wyświetlana przed zakupem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Após o período de avaliação, uma compra única de Full Access desbloqueia o painel. O preço é apresentado antes da compra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "试用结束后，单次购买“完全访问权限”可解锁仪表盘。价格将在购买前显示。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "試用期間終了後、1回限りのフルアクセス購入でダッシュボードがアンロックされます。価格は購入前に表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "체험판 종료 후, 대시보드를 잠금 해제하려면 일회성 전체 액세스 구매가 필요합니다. 가격은 구매 전에 표시됩니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد انتهاء الفترة التجريبية، يفتح شراء وصول كامل لمرة واحدة لوحة التحكم. سيتم عرض السعر قبل الشراء."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "परीक्षण के बाद, एक बार की फुल एक्सेस खरीद से डैशबोर्ड अनलॉक होता है। कीमत खरीद से पहले दिखाई जाएगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah masa percobaan, pembelian Akses Penuh satu kali akan membuka dasbor. Harga ditampilkan sebelum pembelian."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deneme süresinden sonra, tek seferlik Tam Erişim satın alımıyla gösterge panelinin kilidi açılır. Fiyat satın almadan önce gösterilir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После окончания пробного периода однократная покупка полного доступа откроет панель управления. Цена будет показана до покупки."
          }
        }
      },
      "extractionState" : "manual"
    },
    "All features are free for seven elapsed days from first use." : {
      "localizations" : {
