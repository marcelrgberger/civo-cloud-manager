    "'Restore Purchase' recovers previous purchases. 'Redeem Code' for Apple offer codes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Restore Purchase' recovers previous purchases. 'Redeem Code' for Apple offer codes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit „Kauf wiederherstellen“ stellst du frühere Käufe wieder her. „Code einlösen“ ist für Apple-Angebotscodes vorgesehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Restaurar compra» recupera compras anteriores. «Canjear código» permite usar códigos de oferta de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Restaurer l’achat» récupère les achats précédents. «Utiliser un code» permet d’utiliser les codes promotionnels Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Ripristina acquisto» recupera gli acquisti precedenti. «Riscatta codice» consente di usare i codici promozionali Apple."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met ‘Aankoop herstellen’ herstel je eerdere aankopen. ‘Code inwisselen’ is bedoeld voor Apple-aanbiedingscodes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Przywróć zakup” przywraca wcześniejsze zakupy. „Zrealizuj kod” służy do realizacji kodów promocyjnych Apple."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Restaurar compra» recupera compras anteriores. «Resgatar código» permite utilizar códigos de oferta da Apple."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“恢复购买”可恢复之前的购买记录。“兑换代码”用于 Apple 优惠码。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「購入を復元」で以前の購入を回復します。「コードを利用」でAppleのオファーコードを利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'구입 복원'은 이전 구매 내역을 복구합니다. Apple 제공 코드가 있다면 '코드 사용'을 선택하세요."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستعيد 'استعادة الشراء' المشتريات السابقة. استخدم 'استرداد الرمز' لعروض Apple."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'खरीदारी पुनर्स्थापित करें' से पूर्व की खरीदारी पुनः प्राप्त करें। 'कोड रिडीम करें' से Apple ऑफर कोड लागू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Pulihkan Pembelian' memulihkan pembelian sebelumnya. 'Tukarkan Kode' untuk kode penawaran Apple."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Satın Almayı Geri Yükle' önceki satın alımları geri getirir. Apple teklif kodları için 'Kodu Kullan'."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Восстановить покупку» позволяет восстановить предыдущие покупки. «Использовать код» — для промокодов Apple."
          }
        }
      },
      "extractionState" : "manual"
    },
