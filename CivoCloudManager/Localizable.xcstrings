    "Only volumes that are not attached and are in the network and region of this instance are listed." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only volumes that are not attached and are in the network and region of this instance are listed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es werden nur Volumes angezeigt, die nicht angehängt sind und im Netzwerk und in der Region dieser Instanz liegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se muestran los volúmenes que no están conectados y que están en la red y la región de esta instancia."
          }
        },
        "fr" : {
          "stringUnit" : {
