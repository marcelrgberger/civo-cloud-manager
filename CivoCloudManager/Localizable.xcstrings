    "The node pool changes were already sent and can no longer be cancelled. Their result is shown here once Civo answers." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The node pool changes were already sent and can no longer be cancelled. Their result is shown here once Civo answers."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Änderungen an den Node-Pools wurden bereits gesendet und können nicht mehr abgebrochen werden. Ihr Ergebnis erscheint hier, sobald Civo antwortet."
