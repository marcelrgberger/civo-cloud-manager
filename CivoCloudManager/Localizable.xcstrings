    "The Civo account changed, so nothing was sent to Civo. Open the action again for the current account." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Civo account changed, so nothing was sent to Civo. Open the action again for the current account."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Civo-Konto hat sich geändert, daher wurde nichts an Civo gesendet. Öffnen Sie die Aktion erneut für das aktuelle Konto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cuenta de Civo cambió, así que no se envió nada a Civo. Abra la acción de nuevo para la cuenta actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
