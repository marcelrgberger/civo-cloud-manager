    "The username and password for this instance are removed from this Mac's keychain." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The username and password for this instance are removed from this Mac's keychain."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benutzername und Passwort dieser Instanz werden aus dem Schlüsselbund dieses Macs entfernt."
