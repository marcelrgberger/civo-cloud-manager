    "The instance had already been deleted, so this request deleted nothing." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The instance had already been deleted, so this request deleted nothing."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Instanz war bereits gelöscht, daher hat diese Anfrage nichts gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La instancia ya se había eliminado, por lo que esta solicitud no eliminó nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'instance avait déjà été supprimée, cette requête n'a donc rien supprimé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'istanza era già stata eliminata, quindi questa richiesta non ha eliminato nulla."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De instantie was al verwijderd, dus dit verzoek heeft niets verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instancja została już usunięta, więc to żądanie niczego nie usunęło."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A instância já havia sido excluída, portanto esta solicitação não excluiu nada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该实例此前已被删除，因此本次请求未删除任何内容。"
