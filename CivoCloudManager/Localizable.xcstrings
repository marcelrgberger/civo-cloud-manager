    "Civo reports load balancer \"%@\" differently from the requested change: %@. Nothing was corrected or sent again. Check it in the list." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo reports load balancer \"%1$@\" differently from the requested change: %2$@. Nothing was corrected or sent again. Check it in the list."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
