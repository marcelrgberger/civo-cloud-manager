        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会结束此实例在 Civo 上的控制台会话，包括在 Civo 控制面板中打开的控制台。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このインスタンスの Civo 上のコンソールセッションが終了します。Civo ダッシュボードで開いているコンソールも含まれます。"
