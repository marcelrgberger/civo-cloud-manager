    "'Cleanup Available' deletes all volumes with status 'available' (requires typing DELETE ALL DATA)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Cleanup Available' deletes all volumes with status 'available' (requires typing DELETE ALL DATA)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Cleanup Available“ löscht alle Volumes mit Status „available“ (erfordert die Eingabe von DELETE ALL DATA)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Limpiar disponibles\" elimina todos los volúmenes con estado \"available\" (requiere escribir DELETE ALL DATA)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Nettoyer les disponibles » supprime tous les volumes avec le statut « available » (nécessite de saisir DELETE ALL DATA)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Cleanup Available\" elimina tutti i volumi con stato \"available\" (richiede di digitare DELETE ALL DATA)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Cleanup Available' verwijdert alle volumes met de status 'available' (vereist het typen van DELETE ALL DATA)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Cleanup Available” usuwa wszystkie woluminy ze statusem „available” (wymaga wpisania DELETE ALL DATA)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Limpar Disponíveis' elimina todos os volumes com o estado 'available' (requer digitar DELETE ALL DATA)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“清理可用”将删除所有状态为“available”的卷（需输入 DELETE ALL DATA 以确认）。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Cleanup Available」はステータスが「available」のすべてのボリュームを削除します（DELETE ALL DATAの入力が必要です）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Cleanup Available’는 상태가 ‘available’인 모든 볼륨을 삭제합니다 (DELETE ALL DATA 입력 필요)."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ميزة 'تنظيف المتاح' تحذف جميع الأقراص ذات الحالة 'available' (يتطلب كتابة DELETE ALL DATA)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Cleanup Available' सभी 'available' स्थिति वाले वॉल्यूम्स को हटाता है (DELETE ALL DATA टाइप करना आवश्यक है)।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Cleanup Available' akan menghapus semua volume dengan status 'available' (memerlukan pengetikan DELETE ALL DATA)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Kullanılabilirleri Temizle' seçeneği, durumu 'available' olan tüm diskleri siler (DELETE ALL DATA yazılması gerekir)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Очистить доступные» удаляет все тома со статусом «available» (требуется ввести DELETE ALL DATA)."
          }
        }
      },
      "extractionState" : "manual"
    },
    "'Close' removes the rule. 'Open All / Close All' for bulk actions." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Close' removes the rule. 'Open All / Close All' for bulk actions."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Schließen“ entfernt die Regel. „Alle öffnen / Alle schließen“ für Massenaktionen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Cerrar\" elimina la regla. \"Abrir todo / Cerrar todo\" para acciones masivas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Fermer » supprime la règle. « Tout ouvrir / Tout fermer » pour les actions groupées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Chiudi\" rimuove la regola. \"Apri tutto / Chiudi tutto\" per azioni di massa."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Sluiten' verwijdert de regel. 'Alles openen / Alles sluiten' voor bulkacties."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Zamknij” usuwa regułę. „Otwórz wszystko / Zamknij wszystko” umożliwia operacje zbiorcze."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Fechar' remove a regra. 'Abrir tudo / Fechar tudo' para ações em massa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“关闭”移除该规则。“全部打开/全部关闭”可批量操作。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「閉じる」はルールを削除します。「すべて開く／すべて閉じる」で一括操作が可能です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘닫기’는 해당 규칙을 제거합니다. ‘모두 열기 / 모두 닫기’로 일괄 작업이 가능합니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'إغلاق' يزيل القاعدة. 'فتح الكل / إغلاق الكل' لتنفيذ الإجراءات الجماعية."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'बंद करें' नियम हटाता है। 'सभी खोलें / सभी बंद करें' से एक साथ कई नियमों पर कार्य करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Tutup' menghapus aturan. 'Buka Semua / Tutup Semua' untuk aksi massal."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Kapat' kuralı kaldırır. 'Tümünü Aç / Tümünü Kapat' toplu işlemler içindir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Закрыть» удаляет правило. «Открыть все / Закрыть все» — массовые действия."
          }
        }
      },
      "extractionState" : "manual"
    },
    "'Edit Rates' lets you customize hourly pricing if needed." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Edit Rates' lets you customize hourly pricing if needed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit „Stundensätze bearbeiten“ können Sie die Preise pro Stunde bei Bedarf anpassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Editar tarifas\" te permite personalizar el precio por hora si es necesario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Modifier les tarifs » vous permet d’ajuster le prix horaire si nécessaire."
