          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civoがこのクラスタのノードを返さなかったため、ノードを特定できず、何も送信されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo가 이 클러스터의 노드를 나열하지 않아 노드를 식별할 수 없으므로 아무것도 전송되지 않았습니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تُدرج Civo عقد هذا العنقود، لذلك لا يمكن تحديد العقدة ولم يُرسَل أي شيء."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo ने इस क्लस्टर के नोड सूचीबद्ध नहीं किए, इसलिए नोड की पहचान नहीं हो सकती और कुछ भी नहीं भेजा गया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo tidak mencantumkan node klaster ini, jadi node tidak dapat diidentifikasi dan tidak ada yang dikirim."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo bu kümenin düğümlerini listelemedi, bu nedenle düğüm belirlenemiyor ve hiçbir şey gönderilmedi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo не вернула список узлов этого кластера, поэтому узел нельзя определить, и ничего не отправлено."
          }
        }
      }
    },
    "The cluster is not on its desired version yet, so no node is replaced. Wait until the upgrade has finished, then try again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The cluster is not on its desired version yet, so no node is replaced. Wait until the upgrade has finished, then try again."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Cluster ist noch nicht auf seiner Zielversion, daher wird kein Knoten ersetzt. Warten Sie, bis das Upgrade abgeschlossen ist, und versuchen Sie es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El clúster aún no está en su versión deseada, así que no se reemplaza ningún nodo. Espere a que finalice la actualización y vuelva a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cluster n'est pas encore à sa version cible, aucun nœud n'est donc remplacé. Attendez la fin de la mise à niveau, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il cluster non è ancora alla versione desiderata, quindi nessun nodo viene sostituito. Attendi il termine dell'aggiornamento, poi riprova."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het cluster heeft zijn gewenste versie nog niet bereikt, daarom wordt er geen node vervangen. Wacht tot de upgrade is voltooid en probeer het dan opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klaster nie ma jeszcze docelowej wersji, więc żaden węzeł nie zostanie wymieniony. Poczekaj na zakończenie aktualizacji i spróbuj ponownie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cluster ainda não está na versão pretendida, por isso nenhum nó é substituído. Aguarde até que a atualização termine e tente novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集群尚未处于目标版本，因此不会替换任何节点。请等待升级完成后重试。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラスタはまだ目的のバージョンになっていません。そのためノードは置き換えられません。アップグレードが完了するまで待ってから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클러스터가 아직 원하는 버전이 아니므로 노드를 교체하지 않습니다. 업그레이드가 완료될 때까지 기다린 후 다시 시도하세요."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العنقود ليس على إصداره المطلوب بعد، لذلك لن تُستبدل أي عقدة. انتظر حتى تكتمل الترقية، ثم حاول مرة أخرى."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्लस्टर अभी अपने वांछित संस्करण पर नहीं है, इसलिए कोई नोड नहीं बदला जाएगा। अपग्रेड पूरा होने तक प्रतीक्षा करें, फिर दोबारा प्रयास करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klaster belum berada pada versi yang diinginkan, jadi tidak ada node yang diganti. Tunggu hingga peningkatan selesai, lalu coba lagi."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Küme henüz hedef sürümünde değil, bu nedenle hiçbir düğüm değiştirilmez. Yükseltme tamamlanana kadar bekleyin, ardından tekrar deneyin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кластер ещё не на целевой версии, поэтому узел не заменяется. Дождитесь завершения обновления и повторите попытку."
          }
        }
      }
    },
    "%@\n\nThe app does not drain the nodes first. Workloads on them are interrupted, and their local data is lost." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nThe app does not drain the nodes first. Workloads on them are interrupted, and their local data is lost."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nDie App leert die Knoten vorher nicht. Workloads auf ihnen werden unterbrochen, und ihre lokalen Daten gehen verloren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nLa app no vacía los nodos antes. Las cargas de trabajo en ellos se interrumpen y sus datos locales se pierden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nL'app ne vide pas les nœuds au préalable. Les charges de travail qui y tournent sont interrompues et leurs données locales sont perdues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nL'app non svuota prima i nodi. I carichi di lavoro su di essi vengono interrotti e i loro dati locali vanno persi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nDe app leegt de nodes niet eerst. Workloads erop worden onderbroken en hun lokale gegevens gaan verloren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nAplikacja nie opróżnia wcześniej węzłów. Obciążenia na nich zostaną przerwane, a ich dane lokalne zostaną utracone."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nO app não esvazia os nós antes. As cargas de trabalho neles são interrompidas e os dados locais são perdidos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n应用不会事先排空这些节点。其上的工作负载会中断，本地数据会丢失。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nアプリはノードを事前にドレインしません。ノード上のワークロードは中断され、ローカルデータは失われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n앱은 노드를 먼저 드레인하지 않습니다. 노드의 워크로드가 중단되고 로컬 데이터가 손실됩니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nلا يفرّغ التطبيق العقد مسبقًا. تتوقف أحمال العمل عليها وتُفقد بياناتها المحلية."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nऐप पहले नोड्स को ड्रेन नहीं करता। उन पर चल रहे वर्कलोड बाधित होते हैं और उनका स्थानीय डेटा खो जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nAplikasi tidak mengosongkan node terlebih dahulu. Beban kerja di dalamnya terputus dan data lokalnya hilang."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nUygulama düğümleri önceden boşaltmaz. Üzerlerindeki iş yükleri kesintiye uğrar ve yerel verileri kaybolur."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nПриложение не освобождает узлы заранее. Рабочие нагрузки на них прерываются, а локальные данные теряются."
          }
        }
      }
    },
