            "value" : "केवल वे वॉल्यूम दिखाए जाते हैं जो जुड़े नहीं हैं और इस इंस्टेंस के नेटवर्क और रीजन में हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya volume yang tidak terpasang dan berada di jaringan serta region instance ini yang ditampilkan."
