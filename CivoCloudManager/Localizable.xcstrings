    "Other S3 clients that use the old credential must be updated to the new one. The old credential is not deleted." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Other S3 clients that use the old credential must be updated to the new one. The old credential is not deleted."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere S3-Clients, die die alten Zugangsdaten verwenden, müssen auf die neuen umgestellt werden. Die alten Zugangsdaten werden nicht gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los demás clientes S3 que usan la credencial anterior deben actualizarse a la nueva. La credencial anterior no se elimina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les autres clients S3 utilisant les anciens identifiants doivent passer aux nouveaux. Les anciens identifiants ne sont pas supprimés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli altri client S3 che usano la vecchia credenziale devono passare alla nuova. La vecchia credenziale non viene eliminata."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere S3-clients die de oude inloggegevens gebruiken, moeten worden bijgewerkt naar de nieuwe. De oude inloggegevens worden niet verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inne klienty S3 korzystające ze starych poświadczeń muszą przejść na nowe. Stare poświadczenia nie są usuwane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os outros clientes S3 que usam a credencial antiga têm de ser atualizados para a nova. A credencial antiga não é eliminada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Другие клиенты S3, использующие старые учетные данные, нужно перевести на новые. Старые учетные данные не удаляются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eski kimlik bilgisini kullanan diğer S3 istemcileri yeni bilgiye güncellenmelidir. Eski kimlik bilgisi silinmez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klien S3 lain yang menggunakan kredensial lama harus diperbarui ke yang baru. Kredensial lama tidak dihapus."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب تحديث عملاء S3 الآخرين الذين يستخدمون بيانات الاعتماد القديمة لاستخدام الجديدة. لن يتم حذف بيانات الاعتماد القديمة."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पुराने क्रेडेंशियल का उपयोग करने वाले अन्य S3 क्लाइंट को नए क्रेडेंशियल पर अपडेट करना होगा। पुराना क्रेडेंशियल हटाया नहीं जाएगा।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "古い認証情報を使用する他のS3クライアントは、新しい認証情報に更新する必要があります。古い認証情報は削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기존 자격 증명을 사용하는 다른 S3 클라이언트는 새 자격 증명으로 업데이트해야 합니다. 기존 자격 증명은 삭제되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用旧凭据的其他 S3 客户端必须更新为新凭据。旧凭据不会被删除。"
          }
        }
      }
    },
