      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn einem pausierten Store die Credential fehlt, können Sie über den Resume-Button eine vorhandene auswählen oder eine neue erstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If a paused store is missing its credential, the Resume button lets you select an existing credential or create a new one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si a un store pausado le falta su credencial, el botón Resume le permite seleccionar una existente o crear una nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si un store en pause n'a pas d'identifiant, le bouton Reprendre permet d'en sélectionner un existant ou d'en créer un nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se a uno store in pausa manca la credenziale, il pulsante Riprendi permette di selezionarne una esistente o crearne una nuova."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als een gepauzeerde store geen credential heeft, kunt u via de knop Hervatten een bestaande selecteren of een nieuwe aanmaken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli wstrzymanemu store brakuje poświadczenia, przycisk Wznów pozwala wybrać istniejące lub utworzyć nowe."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se um store pausado não tiver credencial, o botão Retomar permite selecionar uma existente ou criar uma nova."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果暂停的存储缺少凭证，点击“恢复”按钮可选择现有凭证或创建新凭证。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一時停止中のストアで認証情報が不足している場合、「再開」ボタンから既存の認証情報を選択するか、新規作成できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일시 중지된 저장소에 자격 증명이 없으면, 재개 버튼을 눌러 기존 자격 증명을 선택하거나 새로 만들 수 있습니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كان المتجر المتوقف مؤقتًا يفتقد بيانات الاعتماد الخاصة به، يتيح لك زر الاستئناف اختيار بيانات اعتماد موجودة أو إنشاء بيانات جديدة."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यदि रुकी हुई स्टोर की क्रेडेंशियल गायब है, तो पुनः शुरू करें बटन आपको मौजूदा क्रेडेंशियल चुनने या नया बनाने की अनुमति देता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika kredensial toko yang dijeda hilang, tombol Lanjutkan memungkinkan Anda memilih kredensial yang sudah ada atau membuat yang baru."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duraklatılmış bir mağazanın kimlik bilgisi eksikse, Devam Et düğmesi mevcut bir kimlik bilgisini seçmenize veya yeni bir tane oluşturmanıza olanak tanır."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если у приостановленного хранилища отсутствуют учётные данные, кнопка «Возобновить» позволит выбрать существующие или создать новые."
          }
        }
      }
    },
