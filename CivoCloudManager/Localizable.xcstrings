          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo riporta il bilanciatore di carico \"%1$@\" diversamente dalla modifica richiesta: %2$@. Non è stato corretto né reinviato nulla. Controllalo nell'elenco."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo meldt load balancer \"%1$@\" anders dan de gevraagde wijziging: %2$@. Er is niets gecorrigeerd of opnieuw verzonden. Controleer hem in de lijst."
          }
        },
        "pl" : {
          "stringUnit" : {
