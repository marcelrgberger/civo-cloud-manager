    "Existing backends cannot be removed or changed in the app yet. Use the Civo dashboard for that." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Existing backends cannot be removed or changed in the app yet. Use the Civo dashboard for that."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorhandene Backends lassen sich in der App noch nicht entfernen oder ändern. Verwenden Sie dafür das Civo-Dashboard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los backends existentes aún no se pueden quitar ni cambiar en la app. Use el panel de Civo para ello."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les backends existants ne peuvent pas encore être supprimés ni modifiés dans l'app. Utilisez le tableau de bord Civo pour cela."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I backend esistenti non si possono ancora rimuovere o modificare nell'app. Usa la dashboard di Civo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestaande backends kunnen nog niet in de app worden verwijderd of gewijzigd. Gebruik daarvoor het Civo-dashboard."
