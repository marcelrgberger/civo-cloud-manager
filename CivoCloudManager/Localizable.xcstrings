    "The region changed, so the instance action was cancelled. Nothing was sent." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The region changed, so the instance action was cancelled. Nothing was sent."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّرت المنطقة، لذلك أُلغي إجراء المثيل. لم يُرسَل أي شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Region hat sich geändert, daher wurde die Aktion für die Instanz abgebrochen. Es wurde nichts gesendet."
