    "A new load balancer creates ongoing charges on your Civo account." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new load balancer creates ongoing charges on your Civo account."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein neuer Load Balancer verursacht laufende Kosten in Ihrem Civo-Konto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
