    "No hourly rate is known for size %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hourly rate is known for size %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für die Größe %@ ist kein Stundensatz bekannt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se conoce ninguna tarifa por hora para el tamaño %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun tarif horaire n'est connu pour la taille %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna tariffa oraria nota per la dimensione %@"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is geen uurtarief bekend voor grootte %@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak znanej stawki godzinowej dla rozmiaru %@"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma tarifa por hora conhecida para o tamanho %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "规格 %@ 没有已知的每小时费率"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイズ %@ の時間料金は不明です"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "크기 %@의 시간당 요금을 알 수 없습니다"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يُعرف سعر بالساعة للحجم %@"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आकार %@ के लिए कोई प्रति घंटा दर ज्ञात नहीं है"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada tarif per jam yang diketahui untuk ukuran %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ boyutu için bilinen bir saatlik ücret yok"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Почасовой тариф для размера %@ неизвестен"
          }
        }
      }
    },
    "No hourly rate is known for the sizes involved, so no cost change can be estimated." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hourly rate is known for the sizes involved, so no cost change can be estimated."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für die betroffenen Größen ist kein Stundensatz bekannt, daher lässt sich keine Kostenänderung schätzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se conoce ninguna tarifa por hora para los tamaños afectados, así que no se puede estimar ningún cambio de costo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun tarif horaire n'est connu pour les tailles concernées, aucune variation de coût ne peut donc être estimée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna tariffa oraria nota per le dimensioni coinvolte, quindi non è possibile stimare alcuna variazione di costo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is geen uurtarief bekend voor de betrokken groottes, daarom kan geen kostenwijziging worden geschat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak znanych stawek godzinowych dla tych rozmiarów, więc nie można oszacować zmiany kosztów."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma tarifa por hora é conhecida para os tamanhos envolvidos, por isso nenhuma alteração de custo pode ser estimada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所涉及的规格没有已知的每小时费率，因此无法估算费用变化。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対象サイズの時間料金が不明なため、コストの変化を見積もれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "관련 크기의 시간당 요금을 알 수 없어 비용 변동을 추정할 수 없습니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يُعرف سعر بالساعة للأحجام المعنية، لذلك لا يمكن تقدير تغيّر التكلفة."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संबंधित आकारों के लिए कोई प्रति घंटा दर ज्ञात नहीं है, इसलिए लागत में बदलाव का अनुमान नहीं लगाया जा सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada tarif per jam yang diketahui untuk ukuran terkait, jadi perubahan biaya tidak dapat diperkirakan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlgili boyutlar için bilinen bir saatlik ücret yok, bu nedenle maliyet değişikliği tahmin edilemez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Почасовые тарифы для затронутых размеров неизвестны, поэтому изменение стоимости оценить нельзя."
          }
        }
      }
    },
    "No total can be estimated, since a rate is unknown. The pools with a known rate change by %@ per hour." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No total can be estimated, since a rate is unknown. The pools with a known rate change by %@ per hour."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es lässt sich keine Summe schätzen, da ein Satz unbekannt ist. Die Pools mit bekanntem Satz ändern sich um %@ pro Stunde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede estimar un total porque se desconoce una tarifa. Los grupos con tarifa conocida cambian %@ por hora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun total ne peut être estimé, car un tarif est inconnu. Les pools au tarif connu varient de %@ par heure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è possibile stimare un totale perché una tariffa è sconosciuta. I pool con tariffa nota variano di %@ all'ora."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er kan geen totaal worden geschat, omdat een tarief onbekend is. De pools met een bekend tarief wijzigen met %@ per uur."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można oszacować sumy, ponieważ jedna stawka jest nieznana. Pule o znanej stawce zmieniają się o %@ na godzinę."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível estimar um total, pois uma tarifa é desconhecida. Os pools com tarifa conhecida mudam %@ por hora."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于有费率未知，无法估算总额。费率已知的节点池每小时变化 %@。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不明な料金があるため合計を見積もれません。料金が分かっているプールは 1 時間あたり %@ 変化します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알 수 없는 요금이 있어 합계를 추정할 수 없습니다. 요금을 아는 풀은 시간당 %@ 변동합니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن تقدير إجمالي لأن أحد الأسعار غير معروف. تتغير المجموعات ذات السعر المعروف بمقدار %@ في الساعة."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई दर अज्ञात होने के कारण कुल का अनुमान नहीं लगाया जा सकता। ज्ञात दर वाले पूल %@ प्रति घंटा बदलते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total tidak dapat diperkirakan karena ada tarif yang tidak diketahui. Kolam dengan tarif yang diketahui berubah %@ per jam."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir ücret bilinmediği için toplam tahmin edilemez. Ücreti bilinen havuzlar saatte %@ değişir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Итог оценить нельзя, так как один тариф неизвестен. Пулы с известным тарифом меняются на %@ в час."
          }
        }
      }
    },
    "Node pool changes for this cluster were already requested. Wait until the cluster shows them, then try again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Node pool changes for this cluster were already requested. Wait until the cluster shows them, then try again."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Änderungen an den Node-Pools dieses Clusters wurden bereits angefordert. Warten Sie, bis der Cluster sie anzeigt, und versuchen Sie es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya se solicitaron cambios en los grupos de nodos de este clúster. Espere a que el clúster los muestre y vuelva a intentarlo."
