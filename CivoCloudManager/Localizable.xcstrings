            "value" : "Civo लोड बैलेंसर \"%1$@\" को अनुरोधित बदलाव से अलग बता रहा है: %2$@। कुछ भी ठीक या दोबारा नहीं भेजा गया। सूची में जाँचें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo melaporkan load balancer \"%1$@\" berbeda dari perubahan yang diminta: %2$@. Tidak ada yang dikoreksi atau dikirim ulang. Periksa di daftar."
          }
        },
        "tr" : {
          "stringUnit" : {
