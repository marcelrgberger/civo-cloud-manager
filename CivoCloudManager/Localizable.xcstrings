    "The 'Copy & Open Terminal' button copies the command for moving the key to ~/.ssh/ and opens Terminal." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The 'Copy & Open Terminal' button copies the command for moving the key to ~/.ssh/ and opens Terminal."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit „Kopieren & Terminal öffnen“ wird der Befehl zum Verschieben des Schlüssels nach ~/.ssh/ kopiert und das Terminal geöffnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El botón \"Copiar y abrir Terminal\" copia el comando para mover la clave a ~/.ssh/ y abre Terminal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bouton « Copier et ouvrir le Terminal » copie la commande pour déplacer la clé vers ~/.ssh/ et ouvre le Terminal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pulsante \"Copia e apri Terminale\" copia il comando per spostare la chiave in ~/.ssh/ e apre il Terminale."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De knop 'Kopiëren & Terminal openen' kopieert het commando om de sleutel naar ~/.ssh/ te verplaatsen en opent Terminal."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przycisk „Kopiuj i otwórz Terminal” kopiuje polecenie przeniesienia klucza do ~/.ssh/ i otwiera Terminal."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O botão 'Copiar e abrir Terminal' copia o comando para mover a chave para ~/.ssh/ e abre o Terminal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“复制并打开终端”按钮会复制将密钥移动到 ~/.ssh/ 的命令并打开终端。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「コピーしてターミナルを開く」ボタンで鍵を~/.ssh/に移動するコマンドをコピーし、ターミナルを開きます。"
