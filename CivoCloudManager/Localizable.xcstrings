        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Учётная запись Civo изменилась, поэтому в Civo ничего не отправлено. Откройте действие заново для текущей учётной записи."
          }
        }
      }
    },
