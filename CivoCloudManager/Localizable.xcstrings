          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "होस्टनेम, आकार, डिस्क इमेज और नेटवर्क आवश्यक हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
