    "The API key changed, so the node pool changes were cancelled. Nothing was sent." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The API key changed, so the node pool changes were cancelled. Nothing was sent."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der API-Schlüssel hat sich geändert, daher wurden die Änderungen an den Node-Pools abgebrochen. Es wurde nichts gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave de API cambió, así que se cancelaron los cambios en los grupos de nodos. No se envió nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé API a changé, les modifications des pools de nœuds ont donc été annulées. Rien n'a été envoyé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiave API è cambiata, quindi le modifiche ai pool di nodi sono state annullate. Non è stato inviato nulla."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De API-sleutel is gewijzigd, daarom zijn de wijzigingen aan de node-pools geannuleerd. Er is niets verzonden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klucz API się zmienił, więc zmiany pul węzłów zostały anulowane. Nic nie zostało wysłane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chave de API mudou, por isso as alterações nos pools de nós foram canceladas. Nada foi enviado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API 密钥已更改，因此节点池更改已取消。未发送任何内容。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API キーが変更されたため、ノードプールの変更はキャンセルされました。何も送信されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API 키가 변경되어 노드 풀 변경이 취소되었습니다. 아무것도 전송되지 않았습니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّر مفتاح API، لذلك أُلغيت تغييرات مجموعات العقد. لم يُرسَل أي شيء."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API कुंजी बदल गई, इसलिए नोड पूल बदलाव रद्द कर दिए गए। कुछ भी नहीं भेजा गया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci API berubah, jadi perubahan kolam node dibatalkan. Tidak ada yang dikirim."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API anahtarı değişti, bu nedenle düğüm havuzu değişiklikleri iptal edildi. Hiçbir şey gönderilmedi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключ API изменился, поэтому изменения пулов узлов отменены. Ничего не отправлено."
          }
        }
      }
    },
    "The added nodes need %lld GB disk, but the quota leaves %lld GB free. Civo may refuse the changes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The added nodes need %lld GB disk, but the quota leaves %lld GB free. Civo may refuse the changes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die hinzugefügten Knoten benötigen %lld GB Speicher, das Kontingent lässt aber nur %lld GB frei. Civo kann die Änderungen ablehnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los nodos añadidos necesitan %lld GB de disco, pero la cuota deja %lld GB libres. Civo puede rechazar los cambios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nœuds ajoutés nécessitent %lld Go de disque, mais le quota laisse %lld Go libres. Civo peut refuser les modifications."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I nodi aggiunti richiedono %lld GB di disco, ma la quota lascia %lld GB liberi. Civo potrebbe rifiutare le modifiche."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De toegevoegde nodes hebben %lld GB schijf nodig, maar de quota laat %lld GB vrij. Civo kan de wijzigingen weigeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodane węzły potrzebują %lld GB dysku, a limit pozostawia %lld GB wolnego miejsca. Civo może odrzucić zmiany."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os nós adicionados precisam de %lld GB de disco, mas a cota deixa %lld GB livres. A Civo pode recusar as alterações."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新增节点需要 %lld GB 磁盘，但配额仅剩 %lld GB。Civo 可能会拒绝这些更改。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追加するノードには %lld GB のディスクが必要ですが、クォータの空きは %lld GB です。Civo が変更を拒否する場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
