        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo 기본값은 버전을 보내지 않으므로 Civo가 기본 버전을 설치합니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الخيار الافتراضي من Civo لا يرسل أي إصدار، لذلك تثبّت Civo إصدارها الافتراضي."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo डिफ़ॉल्ट कोई संस्करण नहीं भेजता, इसलिए Civo अपना डिफ़ॉल्ट संस्करण इंस्टॉल करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Default Civo tidak mengirim versi, jadi Civo memasang versi default-nya."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo varsayılanı sürüm göndermez, bu nedenle Civo kendi varsayılan sürümünü kurar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При варианте \"По умолчанию Civo\" версия не отправляется, поэтому Civo установит свою версию по умолчанию."
          }
        }
      }
    },
