    "The vault ('civo-cloud-manager') auto-resizes as needed and shrinks after resume." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Tresor ('civo-cloud-manager') passt seine Größe automatisch an und wird nach dem Fortsetzen verkleinert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The vault ('civo-cloud-manager') auto-resizes as needed and shrinks after resume."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bóveda ('civo-cloud-manager') se redimensiona automáticamente según sea necesario y se reduce después de reanudar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le coffre-fort (« civo-cloud-manager ») se redimensionne automatiquement et se réduit après la reprise."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cassaforte ('civo-cloud-manager') si ridimensiona automaticamente e si riduce dopo il ripristino."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kluis ('civo-cloud-manager') past automatisch de grootte aan en wordt kleiner na hervatten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sejf ('civo-cloud-manager') automatycznie zmienia rozmiar i zmniejsza się po wznowieniu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cofre ('civo-cloud-manager') redimensiona automaticamente conforme necessário e diminui após retomar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保险库（'civo-cloud-manager'）会根据需要自动调整大小，并在恢复后缩小。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボールト（「civo-cloud-manager」）は必要に応じて自動的にサイズ変更され、再開後に縮小されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "볼트('civo-cloud-manager')는 필요에 따라 자동으로 크기가 조정되며, 재개 후 축소됩니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تغيير حجم المخزن ('civo-cloud-manager') تلقائيًا حسب الحاجة ويصغر بعد الاستئناف."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वॉल्ट ('civo-cloud-manager') आवश्यकता अनुसार स्वतः आकार बदलता है और फिर से शुरू करने के बाद छोटा हो जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vault ('civo-cloud-manager') akan menyesuaikan ukuran secara otomatis sesuai kebutuhan dan mengecil setelah dilanjutkan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasa ('civo-cloud-manager') gerektiğinde otomatik olarak yeniden boyutlandırılır ve devam ettikten sonra küçülür."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хранилище («civo-cloud-manager») автоматически изменяет размер по мере необходимости и уменьшается после возобновления."
          }
        }
      }
    },
