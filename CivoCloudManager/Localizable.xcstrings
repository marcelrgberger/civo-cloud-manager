    "Applications may create resources that incur additional Civo charges; this app does not calculate those charges." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد تُنشئ التطبيقات موارد تترتّب عليها رسوم إضافية من Civo؛ لا يحسب هذا التطبيق تلك الرسوم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anwendungen können Ressourcen anlegen, für die zusätzliche Civo-Kosten anfallen; diese App berechnet diese Kosten nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applications may create resources that incur additional Civo charges; this app does not calculate those charges."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las aplicaciones pueden crear recursos que generen cargos adicionales de Civo; esta app no calcula esos cargos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les applications peuvent créer des ressources entraînant des frais Civo supplémentaires ; cette app ne calcule pas ces frais."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप्लिकेशन ऐसे संसाधन बना सकते हैं जिन पर Civo के अतिरिक्त शुल्क लगते हैं; यह ऐप उन शुल्कों की गणना नहीं करता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi dapat membuat sumber daya yang menimbulkan biaya Civo tambahan; aplikasi ini tidak menghitung biaya tersebut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le applicazioni possono creare risorse che comportano costi Civo aggiuntivi; questa app non calcola tali costi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリケーションは追加の Civo 料金が発生するリソースを作成する場合があります。このアプリはその料金を計算しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "애플리케이션이 추가 Civo 요금이 발생하는 리소스를 만들 수 있습니다. 이 앱은 해당 요금을 계산하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applicaties kunnen resources aanmaken waarvoor extra Civo-kosten gelden; deze app berekent die kosten niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacje mogą tworzyć zasoby generujące dodatkowe opłaty w Civo; ta aplikacja nie oblicza tych opłat."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As aplicações podem criar recursos que geram custos adicionais no Civo; esta app não calcula esses custos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложения могут создавать ресурсы, за которые Civo взимает дополнительную плату; это приложение не рассчитывает эти расходы."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamalar ek Civo ücretlerine yol açan kaynaklar oluşturabilir; bu uygulama bu ücretleri hesaplamaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用程序可能会创建产生额外 Civo 费用的资源；本应用不计算这些费用。"
          }
        }
      }
    },
