          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konsola nie jest jeszcze dostępna. Spróbuj ponownie za chwilę."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A consola ainda não está acessível. Tente novamente daqui a pouco."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "控制台暂时无法访问。请稍后再试。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンソールにはまだ接続できません。しばらくしてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "콘솔에 아직 연결할 수 없습니다. 잠시 후 다시 시도하세요."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن الوصول إلى وحدة التحكم بعد. حاول مرة أخرى بعد لحظة."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कंसोल अभी उपलब्ध नहीं है। थोड़ी देर में फिर से प्रयास करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konsol belum dapat dijangkau. Coba lagi sebentar lagi."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konsola henüz ulaşılamıyor. Biraz sonra yeniden deneyin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Консоль пока недоступна. Повторите попытку чуть позже."
          }
        }
      }
    },
