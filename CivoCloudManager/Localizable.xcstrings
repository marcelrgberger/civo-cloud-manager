          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch ID atau kata sandi sistem diperlukan untuk menyimpan kredensial."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimlik bilgilerini kaydetmek için Touch ID ya da sistem parolası gerekir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы сохранить учётные данные, нужен Touch ID или системный пароль."
