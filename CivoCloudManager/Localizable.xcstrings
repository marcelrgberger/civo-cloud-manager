        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Regel lässt derzeit deine eigene öffentliche IP-Adresse zu. Nach der Änderung kannst du den Zugang verlieren, zum Beispiel über SSH."
