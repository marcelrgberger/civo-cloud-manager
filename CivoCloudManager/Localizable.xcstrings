          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo가 더 이상 크기 %@을(를) 제공하지 않아 아무것도 전송되지 않았습니다."
          }
        },
        "ar" : {
          "stringUnit" : {
