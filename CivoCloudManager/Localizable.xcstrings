          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A região mudou, por isso a ação da instância foi cancelada. Nada foi enviado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Регион изменился, поэтому действие с инстансом отменено. Ничего не отправлено."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
