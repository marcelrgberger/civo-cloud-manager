          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo 报告的负载均衡器 \"%1$@\" 与请求的更改不同：%2$@。未进行任何更正或重新发送。请在列表中检查。"
          }
