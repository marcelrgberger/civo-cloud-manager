          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra le credenziali iniziali indicate da Civo. Una password modificata in seguito sull’istanza non viene mostrata qui."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont de initiële inloggegevens van Civo. Een later op de instantie gewijzigd wachtwoord wordt hier niet getoond."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje początkowe dane logowania podane przez Civo. Hasło zmienione później na instancji nie jest tu wyświetlane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra as credenciais iniciais indicadas pela Civo. Uma palavra-passe alterada mais tarde na instância não é mostrada aqui."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示 Civo 提供的初始登录信息。之后在实例上更改的密码不会在此显示。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo が提供する初期ログイン情報を表示します。後でインスタンス上で変更したパスワードはここには表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo가 제공한 초기 로그인 정보를 표시합니다. 나중에 인스턴스에서 변경한 비밀번호는 여기에 표시되지 않습니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض بيانات تسجيل الدخول الأولية التي تُبلغ عنها Civo. لا تظهر هنا كلمة المرور التي تم تغييرها لاحقًا على المثيل."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo द्वारा बताया गया प्रारंभिक लॉगिन दिखाता है। इंस्टेंस पर बाद में बदला गया पासवर्ड यहाँ नहीं दिखाया जाता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menampilkan login awal yang dilaporkan Civo. Kata sandi yang diubah kemudian di instans tidak ditampilkan di sini."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo tarafından bildirilen ilk oturum açma bilgilerini gösterir. Örnekte daha sonra değiştirilen bir parola burada gösterilmez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает начальные данные для входа, сообщённые Civo. Пароль, изменённый позже на экземпляре, здесь не отображается."
          }
        }
      }
    },
