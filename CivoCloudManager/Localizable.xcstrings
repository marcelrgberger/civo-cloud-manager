            "value" : "Wyświetlane są tylko wolumeny, które nie są podłączone i znajdują się w sieci i regionie tej instancji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "São listados apenas volumes que não estão anexados e estão na rede e na região desta instância."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続されておらず、このインスタンスと同じネットワークとリージョンにあるボリュームのみが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결되지 않았고 이 인스턴스의 네트워크와 리전에 있는 볼륨만 표시됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅列出未挂载且位于此实例网络和区域中的卷。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُعرض فقط وحدات التخزين غير المرفقة الموجودة في شبكة هذا المثيل ومنطقته."
          }
        },
        "hi" : {
          "stringUnit" : {
