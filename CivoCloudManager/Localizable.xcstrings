          }
        }
      }
    },
    "The account or region changed. Reopen the credential change. Nothing was sent." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The account or region changed. Reopen the credential change. Nothing was sent."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Konto oder die Region wurde geändert. Öffne den Zugangsdatenwechsel erneut. Es wurde nichts gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cuenta o región ha cambiado. Vuelve a abrir el cambio de credenciales. No se ha enviado nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le compte ou la région a changé. Rouvrez la modification des identifiants. Rien n'a été envoyé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'account o la regione è cambiato. Riapri la modifica delle credenziali. Non è stato inviato nulla."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het account of de regio is gewijzigd. Open de wijziging opnieuw. Er is niets verzonden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konto lub region uległ zmianie. Otwórz ponownie zmianę poświadczeń. Nic nie wysłano."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conta ou região mudou. Abra novamente a alteração de credenciais. Nada foi enviado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аккаунт или регион изменился. Откройте смену учетных данных заново. Ничего не отправлено."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesap veya bölge değişti. Kimlik bilgisi değişikliğini yeniden açın. Hiçbir şey gönderilmedi."
          }
        },
        "id" : {
