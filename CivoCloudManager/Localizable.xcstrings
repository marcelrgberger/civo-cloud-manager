    "The list of versions could not be loaded, so Civo installs its default version." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The list of versions could not be loaded, so Civo installs its default version."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Liste der Versionen konnte nicht geladen werden, daher installiert Civo seine Standardversion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo cargar la lista de versiones, así que Civo instala su versión predeterminada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La liste des versions n'a pas pu être chargée, Civo installe donc sa version par défaut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile caricare l'elenco delle versioni, quindi Civo installa la sua versione predefinita."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De lijst met versies kon niet worden geladen, daarom installeert Civo zijn standaardversie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się załadować listy wersji, więc Civo zainstaluje swoją wersję domyślną."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível carregar a lista de versões, por isso a Civo instala sua versão padrão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法加载版本列表，因此 Civo 将安装其默认版本。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バージョン一覧を読み込めなかったため、Civoはデフォルトのバージョンをインストールします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "버전 목록을 불러올 수 없어 Civo가 기본 버전을 설치합니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تحميل قائمة الإصدارات، لذلك تثبّت Civo إصدارها الافتراضي."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संस्करणों की सूची लोड नहीं हो सकी, इसलिए Civo अपना डिफ़ॉल्ट संस्करण इंस्टॉल करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daftar versi tidak dapat dimuat, jadi Civo memasang versi default-nya."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sürüm listesi yüklenemedi, bu nedenle Civo kendi varsayılan sürümünü kurar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось загрузить список версий, поэтому Civo установит свою версию по умолчанию."
          }
        }
      }
    },
    "Civo default sends no version, so Civo installs the version it marks as default, currently %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo default sends no version, so Civo installs the version it marks as default, currently %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo-Standard sendet keine Version, daher installiert Civo die Version, die es als Standard markiert, derzeit %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predeterminada de Civo no envía ninguna versión, así que Civo instala la versión que marca como predeterminada, actualmente %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par défaut de Civo n'envoie aucune version, Civo installe donc la version qu'il marque par défaut, actuellement %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predefinita di Civo non invia alcuna versione, quindi Civo installa la versione che indica come predefinita, attualmente %@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo-standaard verzendt geen versie, daarom installeert Civo de versie die het als standaard markeert, momenteel %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domyślna Civo nie wysyła wersji, więc Civo zainstaluje wersję oznaczoną jako domyślna, obecnie %@."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Padrão da Civo não envia nenhuma versão, por isso a Civo instala a versão que marca como padrão, atualmente %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo 默认不发送版本，因此 Civo 将安装其标记为默认的版本，当前为 %@。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civoのデフォルトではバージョンを送信しないため、Civoがデフォルトとして指定しているバージョン(現在は%@)がインストールされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo 기본값은 버전을 보내지 않으므로 Civo가 기본값으로 지정한 버전(현재 %@)을 설치합니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الخيار الافتراضي من Civo لا يرسل أي إصدار، لذلك تثبّت Civo الإصدار الذي تحدده افتراضيًا، وهو حاليًا %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo डिफ़ॉल्ट कोई संस्करण नहीं भेजता, इसलिए Civo वह संस्करण इंस्टॉल करता है जिसे वह डिफ़ॉल्ट के रूप में चिह्नित करता है, अभी %@।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Default Civo tidak mengirim versi, jadi Civo memasang versi yang ditandainya sebagai default, saat ini %@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo varsayılanı sürüm göndermez, bu nedenle Civo varsayılan olarak işaretlediği sürümü kurar, şu anda %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При варианте \"По умолчанию Civo\" версия не отправляется, поэтому Civo установит версию, отмеченную как версия по умолчанию, сейчас %@."
          }
        }
      }
    },
    "Civo default sends no version, so Civo installs its default version." : {
      "localizations" : {
        "en" : {
