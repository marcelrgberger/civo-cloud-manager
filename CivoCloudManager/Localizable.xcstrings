    "The username and password for this instance are removed from this Mac's keychain." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The username and password for this instance are removed from this Mac's keychain."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benutzername und Passwort dieser Instanz werden aus dem Schlüsselbund dieses Macs entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nombre de usuario y la contraseña de esta instancia se eliminan del llavero de este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nom d'utilisateur et le mot de passe de cette instance sont supprimés du trousseau de ce Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nome utente e la password di questa istanza vengono rimossi dal portachiavi di questo Mac."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
