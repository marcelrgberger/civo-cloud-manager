    "Hostname, size, disk image and network are required." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hostname, size, disk image and network are required."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hostname, Größe, Disk-Image und Netzwerk sind erforderlich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se requieren el nombre de host, el tamaño, la imagen de disco y la red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nom d'hôte, la taille, l'image disque et le réseau sont obligatoires."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nome host, dimensione, immagine disco e rete sono obbligatori."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hostnaam, grootte, schijfimage en netwerk zijn verplicht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
