          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब तक रिकवरी मोड सक्रिय है, इंस्टेंस तक केवल कंसोल से पहुँचा जा सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
