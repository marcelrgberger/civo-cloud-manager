    "Civo accepted the request, but its answer could not be read. Check the instance list before creating again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo accepted the request, but its answer could not be read. Check the instance list before creating again."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo hat die Anfrage angenommen, aber die Antwort konnte nicht gelesen werden. Prüfe die Instanzliste, bevor du erneut erstellst."
