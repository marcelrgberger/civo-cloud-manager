    "%lld instances of size %@ will be created. No hourly rate is known for this size, so no cost can be estimated." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld instances of size %@ will be created. No hourly rate is known for this size, so no cost can be estimated."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es werden %1$lld Instanzen der Größe %2$@ erstellt. Für diese Größe ist kein Stundensatz bekannt, daher können keine Kosten geschätzt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se crearán %1$lld instancias del tamaño %2$@. No se conoce ninguna tarifa por hora para este tamaño, por lo que no se puede estimar el coste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld instances de taille %2$@ seront créées. Aucun tarif horaire n'est connu pour cette taille, le coût ne peut donc pas être estimé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verranno create %1$lld istanze di dimensione %2$@. Per questa dimensione non è nota alcuna tariffa oraria, quindi il costo non può essere stimato."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er worden %1$lld instanties van grootte %2$@ aangemaakt. Voor deze grootte is geen uurtarief bekend, daarom kunnen de kosten niet worden geschat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zostanie utworzonych instancji rozmiaru %2$@: %1$lld. Dla tego rozmiaru nie jest znana stawka godzinowa, więc nie można oszacować kosztu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serão criadas %1$lld instâncias do tamanho %2$@. Não é conhecida nenhuma tarifa por hora para este tamanho, por isso não é possível estimar o custo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将创建 %1$lld 个规格为 %2$@ 的实例。此规格没有已知的小时费率，因此无法估算费用。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイズ %2$@ のインスタンスを %1$lld 個作成します。このサイズの時間単価が不明なため、費用を見積もれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "크기가 %2$@인 인스턴스 %1$lld개가 생성됩니다. 이 크기의 시간당 요금을 알 수 없어 비용을 추정할 수 없습니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم إنشاء %1$lld مثيلات بالحجم %2$@. لا يُعرف سعر بالساعة لهذا الحجم، لذا لا يمكن تقدير التكلفة."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आकार %2$@ के %1$lld इंस्टेंस बनाए जाएंगे। इस आकार के लिए कोई प्रति घंटा दर ज्ञात नहीं है, इसलिए लागत का अनुमान नहीं लगाया जा सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld instance dengan ukuran %2$@ akan dibuat. Tidak ada tarif per jam yang diketahui untuk ukuran ini, jadi biaya tidak dapat diperkirakan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ boyutunda %1$lld sunucu oluşturulacak. Bu boyut için bilinen bir saatlik ücret yok, bu nedenle maliyet tahmin edilemiyor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будет создано экземпляров размера %2$@: %1$lld. Почасовая ставка для этого размера неизвестна, поэтому стоимость оценить нельзя."
          }
        }
      }
    },
    "%lld instances of size %@ will be created, at an estimated %@ per hour in total. Public IP addresses are not included in this estimate." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld instances of size %@ will be created, at an estimated %@ per hour in total. Public IP addresses are not included in this estimate."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es werden %1$lld Instanzen der Größe %2$@ erstellt, geschätzt insgesamt %3$@ pro Stunde. Öffentliche IP-Adressen sind in dieser Schätzung nicht enthalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se crearán %1$lld instancias del tamaño %2$@, con un coste estimado total de %3$@ por hora. Las direcciones IP públicas no están incluidas en esta estimación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld instances de taille %2$@ seront créées, pour un coût estimé de %3$@ par heure au total. Les adresses IP publiques ne sont pas incluses dans cette estimation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verranno create %1$lld istanze di dimensione %2$@, con un costo stimato totale di %3$@ all'ora. Gli indirizzi IP pubblici non sono inclusi in questa stima."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er worden %1$lld instanties van grootte %2$@ aangemaakt, naar schatting %3$@ per uur in totaal. Openbare IP-adressen zijn niet in deze schatting opgenomen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zostanie utworzonych instancji rozmiaru %2$@: %1$lld, za szacunkowo %3$@ za godzinę łącznie. Publiczne adresy IP nie są uwzględnione w tym szacunku."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serão criadas %1$lld instâncias do tamanho %2$@, com um custo estimado total de %3$@ por hora. Os endereços IP públicos não estão incluídos nesta estimativa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将创建 %1$lld 个规格为 %2$@ 的实例，预计总费用为每小时 %3$@。此估算不包括公网 IP 地址。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイズ %2$@ のインスタンスを %1$lld 個作成します。見積もり費用は合計で 1 時間あたり %3$@ です。パブリック IP アドレスはこの見積もりに含まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "크기가 %2$@인 인스턴스 %1$lld개가 생성되며, 예상 비용은 시간당 총 %3$@입니다. 공인 IP 주소는 이 추정에 포함되지 않습니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم إنشاء %1$lld مثيلات بالحجم %2$@، بتكلفة تقديرية إجمالية قدرها %3$@ في الساعة. عناوين IP العامة غير مشمولة في هذا التقدير."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आकार %2$@ के %1$lld इंस्टेंस बनाए जाएंगे, अनुमानित कुल लागत %3$@ प्रति घंटा। सार्वजनिक IP पते इस अनुमान में शामिल नहीं हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld instance dengan ukuran %2$@ akan dibuat, dengan perkiraan total %3$@ per jam. Alamat IP publik tidak termasuk dalam perkiraan ini."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ boyutunda %1$lld sunucu oluşturulacak, tahmini toplam maliyet saatte %3$@. Genel IP adresleri bu tahmine dahil değildir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будет создано экземпляров размера %2$@: %1$lld, ориентировочно %3$@ в час в сумме. Публичные IP-адреса в эту оценку не входят."
          }
        }
      }
    },
    "The remaining quota does not allow this many instances. Lower the count." : {
