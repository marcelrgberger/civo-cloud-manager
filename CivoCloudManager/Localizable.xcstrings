    "Only larger sizes are shown. Civo cannot resize an instance to a smaller size." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر الأحجام الأكبر فقط. لا يمكن لـ Civo تصغير حجم المثيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es werden nur größere Größen angezeigt. Civo kann eine Instanz nicht verkleinern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only larger sizes are shown. Civo cannot resize an instance to a smaller size."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se muestran tamaños mayores. Civo no puede reducir el tamaño de una instancia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seules les tailles plus grandes sont affichées. Civo ne peut pas réduire la taille d'une instance."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल बड़े आकार दिखाए जाते हैं। Civo किसी इंस्टेंस को छोटे आकार में नहीं बदल सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya ukuran yang lebih besar yang ditampilkan. Civo tidak dapat mengecilkan ukuran instans."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono mostrate solo dimensioni più grandi. Civo non può ridurre la dimensione di un'istanza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "より大きなサイズのみ表示されます。Civo ではインスタンスを小さいサイズに変更できません。"
          }
        },
