          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्लस्टर व्यस्त है (स्थिति %@), इसलिए कोई नोड नहीं बदला जाएगा। इसके सक्रिय होने तक प्रतीक्षा करें, फिर दोबारा प्रयास करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klaster sedang sibuk (status %@), jadi tidak ada node yang diganti. Tunggu hingga aktif, lalu coba lagi."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Küme meşgul (durum %@), bu nedenle hiçbir düğüm değiştirilmez. Etkin olana kadar bekleyin, ardından tekrar deneyin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кластер занят (статус %@), поэтому узел не заменяется. Дождитесь, пока он станет активным, и повторите попытку."
          }
        }
      }
