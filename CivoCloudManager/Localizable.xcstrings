          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen volumes die niet zijn gekoppeld en in het netwerk en de regio van deze instantie liggen, worden getoond."
          }
        },
        "pl" : {
          "stringUnit" : {
