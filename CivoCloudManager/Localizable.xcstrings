        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस क्लस्टर के नोड पूल बदलावों का अनुरोध पहले ही किया जा चुका है। क्लस्टर में दिखने तक प्रतीक्षा करें, फिर दोबारा प्रयास करें।"
