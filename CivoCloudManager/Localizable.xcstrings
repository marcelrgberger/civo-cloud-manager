    "The region changed, so the node pool changes were cancelled. Nothing was sent." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The region changed, so the node pool changes were cancelled. Nothing was sent."
