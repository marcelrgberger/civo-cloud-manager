    "Civo refused the request. Check the name, network, backends and your quota in the Civo dashboard." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo refused the request. Check the name, network, backends and your quota in the Civo dashboard."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo hat die Anfrage abgelehnt. Prüfen Sie Name, Netzwerk, Backends und Ihr Kontingent im Civo-Dashboard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo rechazó la solicitud. Revise el nombre, la red, los backends y su cuota en el panel de Civo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
