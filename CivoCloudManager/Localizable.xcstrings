          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo meldt geen initiële gebruiker of wachtwoord voor deze instantie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo nie podaje użytkownika ani hasła początkowego dla tej instancji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Civo não indica nenhum utilizador nem palavra-passe inicial para esta instância."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo 未提供此实例的初始用户或密码。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo はこのインスタンスの初期ユーザーまたはパスワードを提供していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo가 이 인스턴스의 초기 사용자 또는 비밀번호를 제공하지 않습니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تُبلغ Civo عن مستخدم أو كلمة مرور أولية لهذا المثيل."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo इस इंस्टेंस के लिए कोई प्रारंभिक यूज़र या पासवर्ड नहीं बताता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo tidak melaporkan pengguna atau kata sandi awal untuk instans ini."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo bu örnek için ilk kullanıcı veya parola bildirmiyor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo не сообщает начального пользователя или пароль для этого экземпляра."
          }
        }
      }
    },
    "Shows the initial login reported by Civo. A password changed later on the instance is not shown here." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows the initial login reported by Civo. A password changed later on the instance is not shown here."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt die von Civo gemeldeten Anfangszugangsdaten. Ein später auf der Instanz geändertes Passwort wird hier nicht angezeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el inicio de sesión inicial indicado por Civo. Una contraseña cambiada después en la instancia no se muestra aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche les identifiants initiaux indiqués par Civo. Un mot de passe modifié ultérieurement sur l’instance n’est pas affiché ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra le credenziali iniziali indicate da Civo. Una password modificata in seguito sull’istanza non viene mostrata qui."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont de initiële inloggegevens van Civo. Een later op de instantie gewijzigd wachtwoord wordt hier niet getoond."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje początkowe dane logowania podane przez Civo. Hasło zmienione później na instancji nie jest tu wyświetlane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra as credenciais iniciais indicadas pela Civo. Uma palavra-passe alterada mais tarde na instância não é mostrada aqui."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示 Civo 提供的初始登录信息。之后在实例上更改的密码不会在此显示。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo が提供する初期ログイン情報を表示します。後でインスタンス上で変更したパスワードはここには表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo가 제공한 초기 로그인 정보를 표시합니다. 나중에 인스턴스에서 변경한 비밀번호는 여기에 표시되지 않습니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض بيانات تسجيل الدخول الأولية التي تُبلغ عنها Civo. لا تظهر هنا كلمة المرور التي تم تغييرها لاحقًا على المثيل."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo द्वारा बताया गया प्रारंभिक लॉगिन दिखाता है। इंस्टेंस पर बाद में बदला गया पासवर्ड यहाँ नहीं दिखाया जाता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menampilkan login awal yang dilaporkan Civo. Kata sandi yang diubah kemudian di instans tidak ditampilkan di sini."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo tarafından bildirilen ilk oturum açma bilgilerini gösterir. Örnekte daha sonra değiştirilen bir parola burada gösterilmez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает начальные данные для входа, сообщённые Civo. Пароль, изменённый позже на экземпляре, здесь не отображается."
          }
        }
      }
    },
