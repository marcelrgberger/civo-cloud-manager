    "All data on these volumes will be permanently lost. This action cannot be undone." : {
      "comment" : "A description of the irreversible nature of deleting unused volumes.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Daten auf diesen Volumes gehen dauerhaft verloren. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All data on these volumes will be permanently lost. This action cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los datos en estos volúmenes se perderán permanentemente. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les données sur ces volumes seront définitivement perdues. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti i dati su questi volumi verranno persi definitivamente. Questa azione non può essere annullata."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle gegevens op deze volumes gaan permanent verloren. Deze actie kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie dane na tych wolumenach zostaną trwale utracone. Tej operacji nie można cofnąć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os dados nestes volumes serão permanentemente perdidos. Esta ação não pode ser desfeita."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些卷上的所有数据都将被永久删除。此操作无法撤销。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのボリューム上のすべてのデータは完全に失われます。この操作は元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 볼륨의 모든 데이터가 영구적으로 삭제됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم فقدان جميع البيانات على هذه الأقراص بشكل دائم. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इन वॉल्यूम्स पर मौजूद सभी डेटा स्थायी रूप से नष्ट हो जाएगा। यह क्रिया पूर्ववत नहीं की जा सकती।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua data pada volume ini akan hilang secara permanen. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu disklerdeki tüm veriler kalıcı olarak silinecek. Bu işlem geri alınamaz."
          }
        },
