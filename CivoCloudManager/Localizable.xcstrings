        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복구 모드가 활성 상태인 동안에는 콘솔을 통해서만 인스턴스에 접근할 수 있습니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
