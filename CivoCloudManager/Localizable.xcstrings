    },
    "Civo reported the recovery mode status in an unexpected form, so it is unknown." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo reported the recovery mode status in an unexpected form, so it is unknown."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo hat den Status des Wiederherstellungsmodus in einer unerwarteten Form gemeldet, daher ist er unbekannt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo informó del estado del modo de recuperación en un formato inesperado, por lo que se desconoce."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo a indiqué l'état du mode de récupération sous une forme inattendue ; il est donc inconnu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo ha riportato lo stato della modalità di ripristino in una forma inattesa, quindi non è noto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo meldde de status van de herstelmodus in een onverwachte vorm, dus die is onbekend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo zgłosiło stan trybu odzyskiwania w nieoczekiwanej postaci, więc jest on nieznany."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Civo indicou o estado do modo de recuperação num formato inesperado, pelo que é desconhecido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo 以意外的格式报告了恢复模式状态,因此状态未知。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo がリカバリモードの状態を想定外の形式で返したため、状態は不明です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo가 예상하지 못한 형식으로 복구 모드 상태를 보고하여 상태를 알 수 없습니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبلغت Civo عن حالة وضع الاسترداد بصيغة غير متوقعة، لذا فهي غير معروفة."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo ने रिकवरी मोड की स्थिति अप्रत्याशित रूप में बताई, इसलिए वह अज्ञात है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo melaporkan status mode pemulihan dalam bentuk yang tidak terduga, sehingga statusnya tidak diketahui."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo kurtarma modu durumunu beklenmeyen bir biçimde bildirdi, bu nedenle durum bilinmiyor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo сообщил состояние режима восстановления в неожиданном виде, поэтому оно неизвестно."
          }
        }
      }
    },
