            "value" : "리전이 변경되어 인스턴스 작업이 취소되었습니다. 아무것도 전송되지 않았습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De regio is gewijzigd, daarom is de actie voor de instantie geannuleerd. Er is niets verzonden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
