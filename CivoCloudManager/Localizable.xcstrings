    "After this change the rule admits traffic from every address on the internet." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After this change the rule admits traffic from every address on the internet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dieser Änderung lässt die Regel Datenverkehr von jeder Adresse im Internet zu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras este cambio, la regla admite tráfico de cualquier dirección de internet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après cette modification, la règle autorise le trafic depuis n'importe quelle adresse d'Internet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo questa modifica la regola ammette traffico da qualsiasi indirizzo di internet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na deze wijziging laat de regel verkeer van elk adres op internet toe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po tej zmianie reguła przepuszcza ruch z każdego adresu w internecie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Após esta alteração, a regra admite tráfego de qualquer endereço da internet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此更改后，该规则将允许来自互联网上任何地址的流量。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この変更後、ルールはインターネット上のすべてのアドレスからの通信を許可します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 변경 후에는 규칙이 인터넷의 모든 주소에서 오는 트래픽을 허용합니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد هذا التغيير تسمح القاعدة بحركة المرور من أي عنوان على الإنترنت."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस बदलाव के बाद नियम इंटरनेट के हर पते से ट्रैफ़िक की अनुमति देगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah perubahan ini, aturan mengizinkan lalu lintas dari setiap alamat di internet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu değişiklikten sonra kural, internetteki her adresten gelen trafiğe izin verir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После этого изменения правило пропускает трафик с любого адреса в интернете."
          }
        }
      }
    },
    "This rule currently admits your own public IP address. After the change you may lose access, for example over SSH." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This rule currently admits your own public IP address. After the change you may lose access, for example over SSH."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Regel lässt derzeit deine eigene öffentliche IP-Adresse zu. Nach der Änderung kannst du den Zugang verlieren, zum Beispiel über SSH."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta regla admite actualmente tu propia dirección IP pública. Tras el cambio podrías perder el acceso, por ejemplo por SSH."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette règle autorise actuellement votre propre adresse IP publique. Après la modification, vous risquez de perdre l'accès, par exemple via SSH."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa regola ammette attualmente il tuo indirizzo IP pubblico. Dopo la modifica potresti perdere l'accesso, ad esempio tramite SSH."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze regel laat momenteel je eigen openbare IP-adres toe. Na de wijziging kun je de toegang verliezen, bijvoorbeeld via SSH."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta reguła przepuszcza obecnie Twój publiczny adres IP. Po zmianie możesz stracić dostęp, na przykład przez SSH."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta regra admite atualmente o seu próprio endereço IP público. Após a alteração, poderá perder o acesso, por exemplo por SSH."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此规则当前允许你自己的公网 IP 地址。更改后你可能会失去访问权限，例如 SSH。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このルールは現在、あなた自身のパブリック IP アドレスを許可しています。変更後は SSH などでアクセスできなくなる可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 규칙은 현재 내 공인 IP 주소를 허용합니다. 변경 후에는 SSH 등으로 접근하지 못할 수 있습니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسمح هذه القاعدة حاليًا بعنوان IP العام الخاص بك. بعد التغيير قد تفقد الوصول، على سبيل المثال عبر SSH."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह नियम अभी आपके अपने सार्वजनिक IP पते की अनुमति देता है। बदलाव के बाद आपकी पहुँच जा सकती है, उदाहरण के लिए SSH पर।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aturan ini saat ini mengizinkan alamat IP publik Anda sendiri. Setelah perubahan, Anda mungkin kehilangan akses, misalnya melalui SSH."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu kural şu anda kendi genel IP adresinize izin veriyor. Değişiklikten sonra örneğin SSH üzerinden erişiminizi kaybedebilirsiniz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это правило сейчас пропускает ваш собственный публичный IP-адрес. После изменения вы можете потерять доступ, например по SSH."
          }
        }
      }
    },
    "Your public IP address could not be detected, so it is unknown whether this change ends your own access." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your public IP address could not be detected, so it is unknown whether this change ends your own access."
          }
