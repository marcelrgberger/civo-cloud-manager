        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्लस्टर अभी अपने लक्षित संस्करण पर नहीं पहुँचा है। एक अपग्रेड अभी चल रहा है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klaster belum mencapai versi yang diinginkan. Upgrade masih berjalan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Küme henüz hedef sürümüne ulaşmadı. Bir yükseltme hâlâ sürüyor."
