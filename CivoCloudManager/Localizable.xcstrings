    "The instance will be rebooted and billed at the new size from then on." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستتم إعادة تشغيل المثيل، ومن ثم تتم محاسبته بالحجم الجديد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Instanz wird neu gestartet und ab dann zur neuen Größe abgerechnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The instance will be rebooted and billed at the new size from then on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La instancia se reiniciará y a partir de entonces se facturará con el nuevo tamaño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'instance sera redémarrée puis facturée selon la nouvelle taille."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंस्टेंस रीबूट होगा और उसके बाद नए आकार के अनुसार बिल किया जाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instans akan di-reboot dan sejak itu ditagih sesuai ukuran baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'istanza verrà riavviata e da quel momento fatturata con la nuova dimensione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インスタンスは再起動され、以後は新しいサイズで課金されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인스턴스가 재부팅되며 이후 새 크기로 요금이 청구됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De instantie wordt opnieuw opgestart en vanaf dan tegen de nieuwe grootte gefactureerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instancja zostanie uruchomiona ponownie i od tej chwili rozliczana według nowego rozmiaru."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A instância será reiniciada e, a partir daí, cobrada pelo novo tamanho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Инстанс будет перезагружен, и с этого момента оплата будет начисляться по новому размеру."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Örnek yeniden başlatılacak ve bundan sonra yeni boyuta göre faturalandırılacak."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实例将重启，此后按新规格计费。"
          }
        }
      }
    },
