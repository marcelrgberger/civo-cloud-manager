          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm özellikler ilk kullanımdan itibaren yedi gün boyunca ücretsizdir."
          }
        },
        "ru" : {
          "stringUnit" : {
