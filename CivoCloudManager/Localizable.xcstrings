    "Your 7-day free trial has ended. Unlock full access with a one-time purchase." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine kostenlose 7-tägige Testphase ist abgelaufen. Schalte mit einem einmaligen Kauf alle Funktionen frei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your 7-day free trial has ended. Unlock full access with a one-time purchase."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu prueba gratuita de 7 días ha finalizado. Desbloquea el acceso completo con una compra única."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre essai gratuit de 7 jours est terminé. Débloquez l’accès complet avec un achat unique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua prova gratuita di 7 giorni è terminata. Sblocca l’accesso completo con un acquisto una tantum."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gratis proefperiode van 7 dagen is afgelopen. Ontgrendel volledige toegang met een eenmalige aankoop."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój 7-dniowy bezpłatny okres próbny dobiegł końca. Odblokuj pełny dostęp dzięki jednorazowemu zakupowi."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu período de avaliação gratuito de 7 dias terminou. Desbloqueie o acesso completo com uma compra única."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的7天免费试用已结束。一次性购买可解锁全部功能。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7日間の無料トライアルが終了しました。1回限りの購入でフルアクセスをアンロックできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7일 무료 체험이 종료되었습니다. 일회성 구매로 전체 액세스를 잠금 해제하세요."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهت فترة التجربة المجانية لمدة 7 يومًا. قم بفتح الوصول الكامل من خلال شراء لمرة واحدة."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका 7-दिवसीय निःशुल्क परीक्षण समाप्त हो गया है। एक बार की खरीद से पूर्ण एक्सेस अनलॉक करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uji coba gratis 7 hari Anda telah berakhir. Buka akses penuh dengan pembelian satu kali."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 günlük ücretsiz deneme süreniz sona erdi. Tek seferlik satın alımla tam erişimin kilidini açın."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш 7-дневный бесплатный период завершён. Откройте полный доступ с помощью однократной покупки."
          }
        }
      }
    },
