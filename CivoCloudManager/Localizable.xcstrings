            "state" : "translated",
            "value" : "All features are free for seven elapsed days from first use."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Funktionen sind ab der ersten Nutzung sieben Tage lang kostenlos."
          }
        },
        "es" : {
