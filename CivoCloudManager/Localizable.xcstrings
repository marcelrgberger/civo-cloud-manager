        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solange der Wiederherstellungsmodus aktiv ist, ist die Instanz nur über die Konsole erreichbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras el modo de recuperación esté activo, solo se puede acceder a la instancia a través de la consola."
          }
        },
        "fr" : {
          "stringUnit" : {
