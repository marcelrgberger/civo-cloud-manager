        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istniejących backendów nie można jeszcze usunąć ani zmienić w aplikacji. Użyj do tego panelu Civo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backends existentes ainda não podem ser removidos ou alterados no app. Use o painel da Civo para isso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂时无法在应用中移除或更改现有后端。请使用 Civo 控制台。"
