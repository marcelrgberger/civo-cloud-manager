        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finché la modalità di ripristino è attiva, l'istanza è raggiungibile solo tramite la console."
          }
        },
        "nl" : {
          "stringUnit" : {
