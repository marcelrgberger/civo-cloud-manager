    "Manage your Civo Cloud infrastructure directly from your Mac.\n\nFirewalls, Kubernetes, databases, and more — all in one app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwalten Sie Ihre Civo Cloud Infrastruktur direkt von Ihrem Mac.\n\nFirewalls, Kubernetes, Datenbanken und mehr — alles in einer App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manage your Civo Cloud infrastructure directly from your Mac.\n\nFirewalls, Kubernetes, databases, and more — all in one app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestiona tu infraestructura Civo Cloud directamente desde tu Mac.\n\nFirewalls, Kubernetes, bases de datos y más — todo en una app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gérez votre infrastructure Civo Cloud directement depuis votre Mac.\n\nPare-feu, Kubernetes, bases de données et plus — tout en une app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestisci la tua infrastruttura Civo Cloud direttamente dal tuo Mac.\n\nFirewall, Kubernetes, database e altro — tutto in un’app."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beheer uw Civo Cloud infrastructuur rechtstreeks vanaf uw Mac.\n\nFirewalls, Kubernetes, databases en meer — alles in één app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zarządzaj infrastrukturą Civo Cloud bezpośrednio z Maca.\n\nFirewalle, Kubernetes, bazy danych i więcej — wszystko w jednej aplikacji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerencie sua infraestrutura Civo Cloud diretamente do seu Mac.\n\nFirewalls, Kubernetes, bases de dados e mais — tudo numa app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直接在您的 Mac 上管理 Civo Cloud 基础设施。\n\n防火墙、Kubernetes、数据库等——一站式应用。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo CloudインフラストラクチャをMacから直接管理できます。\n\nファイアウォール、Kubernetes、データベースなど、すべてを1つのアプリで。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac에서 직접 Civo Cloud 인프라를 관리하세요.\n\n방화벽, Kubernetes, 데이터베이스 등 모든 기능을 하나의 앱에서 제공합니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بإدارة بنية Civo Cloud التحتية مباشرة من جهاز Mac الخاص بك.\n\nجدران الحماية، Kubernetes، قواعد البيانات والمزيد — كل ذلك في تطبيق واحد."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने Mac से सीधे अपनी Civo Cloud अवसंरचना प्रबंधित करें।\n\nफ़ायरवॉल, Kubernetes, डेटाबेस और बहुत कुछ — सब कुछ एक ही ऐप में।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kelola infrastruktur Civo Cloud Anda langsung dari Mac Anda.\n\nFirewall, Kubernetes, basis data, dan lainnya — semua dalam satu aplikasi."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo Cloud altyapınızı doğrudan Mac'inizden yönetin.\n\nGüvenlik duvarları, Kubernetes, veritabanları ve daha fazlası — hepsi tek bir uygulamada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Управляйте своей инфраструктурой Civo Cloud прямо с Mac.\n\nМежсетевые экраны, Kubernetes, базы данных и многое другое — всё в одном приложении."
          }
        }
      }
    },
