          "stringUnit" : {
            "state" : "translated",
            "value" : "زر 'نسخ وفتح الطرفية' ينسخ الأمر لنقل المفتاح إلى ~/.ssh/ ويفتح الطرفية."
          }
        },
        "hi" : {
