    "Touch ID or a system password is required to save credentials." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch ID or a system password is required to save credentials."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Speichern von Zugangsdaten ist Touch ID oder ein Systempasswort erforderlich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita Touch ID o una contraseña del sistema para guardar credenciales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch ID ou un mot de passe système est requis pour enregistrer des identifiants."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per salvare le credenziali serve Touch ID o una password di sistema."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch ID of een systeemwachtwoord is vereist om inloggegevens op te slaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do zapisania danych logowania wymagany jest Touch ID lub hasło systemowe."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É necessário Touch ID ou uma palavra-passe do sistema para guardar credenciais."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要 Touch ID 或系统密码才能保存凭据。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "認証情報を保存するには、Touch ID またはシステムパスワードが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자격 증명을 저장하려면 Touch ID 또는 시스템 암호가 필요합니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يلزم Touch ID أو كلمة مرور النظام لحفظ بيانات الدخول."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
