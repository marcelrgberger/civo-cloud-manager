    "Stored only in this Mac's keychain, without iCloud sync. Showing, copying and editing require Touch ID or your system password." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stored only in this Mac's keychain, without iCloud sync. Showing, copying and editing require Touch ID or your system password."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur im Schlüsselbund dieses Macs gespeichert, ohne iCloud-Synchronisierung. Anzeigen, Kopieren und Bearbeiten erfordern Touch ID oder dein Systempasswort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guardan solo en el llavero de este Mac, sin sincronización con iCloud. Para mostrar, copiar y editar se necesita Touch ID o la contraseña del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stockés uniquement dans le trousseau de ce Mac, sans synchronisation iCloud. Afficher, copier et modifier nécessitent Touch ID ou votre mot de passe système."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvate solo nel portachiavi di questo Mac, senza sincronizzazione iCloud. Per mostrare, copiare e modificare servono Touch ID o la password di sistema."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen opgeslagen in de sleutelhanger van deze Mac, zonder iCloud-synchronisatie. Tonen, kopiëren en bewerken vereisen Touch ID of je systeemwachtwoord."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przechowywane tylko w pęku kluczy tego Maca, bez synchronizacji iCloud. Wyświetlanie, kopiowanie i edycja wymagają Touch ID lub hasła systemowego."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardadas apenas no porta-chaves deste Mac, sem sincronização com o iCloud. Mostrar, copiar e editar requer Touch ID ou a palavra-passe do sistema."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅存储在此 Mac 的钥匙串中，不通过 iCloud 同步。显示、复制和编辑需要 Touch ID 或系统密码。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac のキーチェーンにのみ保存され、iCloud では同期されません。表示、コピー、編集には Touch ID またはシステムパスワードが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac의 키체인에만 저장되며 iCloud로 동기화되지 않습니다. 표시, 복사 및 편집에는 Touch ID 또는 시스템 암호가 필요합니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُخزَّن في سلسلة مفاتيح هذا الـ Mac فقط، دون مزامنة عبر iCloud. يتطلب العرض والنسخ والتعديل Touch ID أو كلمة مرور النظام."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल इस Mac के कीचेन में सहेजे जाते हैं, iCloud सिंक के बिना। दिखाने, कॉपी करने और संपादित करने के लिए Touch ID या सिस्टम पासवर्ड आवश्यक है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya disimpan di rantai kunci Mac ini, tanpa sinkronisasi iCloud. Menampilkan, menyalin, dan mengedit memerlukan Touch ID atau kata sandi sistem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca bu Mac'in Anahtar Zinciri'nde saklanır, iCloud ile eşzamanlanmaz. Gösterme, kopyalama ve düzenleme için Touch ID ya da sistem parolası gerekir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хранятся только в связке ключей этого Mac, без синхронизации с iCloud. Для показа, копирования и изменения нужен Touch ID или системный пароль."
          }
        }
      }
    },
    "Delete the saved credentials?" : {
