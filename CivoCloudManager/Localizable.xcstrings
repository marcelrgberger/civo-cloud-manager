          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Civo não listou os nós deste cluster, por isso o nó não pode ser identificado e nada foi enviado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
