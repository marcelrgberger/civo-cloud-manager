          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana bilgisayar adı, boyut, disk imajı ve ağ zorunludur."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имя хоста, размер, образ диска и сеть обязательны."
          }
        }
      }
    },
    "Create Instance stays disabled until hostname, size, disk image and network are set. The default network is preselected, and only firewalls of the selected network are offered." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create Instance stays disabled until hostname, size, disk image and network are set. The default network is preselected, and only firewalls of the selected network are offered."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instanz erstellen bleibt deaktiviert, bis Hostname, Größe, Disk-Image und Netzwerk gesetzt sind. Das Standardnetzwerk ist vorausgewählt, und es werden nur Firewalls des gewählten Netzwerks angeboten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crear instancia permanece desactivado hasta que se definan el nombre de host, el tamaño, la imagen de disco y la red. La red predeterminada viene preseleccionada y solo se ofrecen los firewalls de la red seleccionada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créer une instance reste désactivé tant que le nom d'hôte, la taille, l'image disque et le réseau ne sont pas définis. Le réseau par défaut est présélectionné, et seuls les pare-feu du réseau choisi sont proposés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea istanza resta disattivato finché nome host, dimensione, immagine disco e rete non sono impostati. La rete predefinita è preselezionata e vengono proposti solo i firewall della rete selezionata."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instantie aanmaken blijft uitgeschakeld tot hostnaam, grootte, schijfimage en netwerk zijn ingesteld. Het standaardnetwerk is vooraf geselecteerd en alleen firewalls van het gekozen netwerk worden aangeboden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utwórz instancję pozostaje nieaktywne, dopóki nie zostaną ustawione nazwa hosta, rozmiar, obraz dysku i sieć. Sieć domyślna jest wstępnie wybrana, a dostępne są tylko zapory sieciowe wybranej sieci."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Criar instância permanece desativado até que o nome do host, o tamanho, a imagem de disco e a rede estejam definidos. A rede predefinida vem pré-selecionada e só são oferecidos os firewalls da rede selecionada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在设置主机名、规格、磁盘映像和网络之前，创建实例保持禁用。默认网络已预先选择，并且只提供所选网络中的防火墙。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホスト名、サイズ、ディスクイメージ、ネットワークを設定するまで、インスタンスを作成は無効のままです。デフォルトのネットワークがあらかじめ選択され、選択したネットワークのファイアウォールのみが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호스트명, 크기, 디스크 이미지, 네트워크를 설정할 때까지 인스턴스 생성은 비활성화된 상태로 유지됩니다. 기본 네트워크가 미리 선택되며, 선택한 네트워크의 방화벽만 표시됩니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى إنشاء مثيل معطلًا حتى يتم تعيين اسم المضيف والحجم وصورة القرص والشبكة. تكون الشبكة الافتراضية محددة مسبقًا، ولا تُعرض إلا جدران الحماية الخاصة بالشبكة المحددة."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "होस्टनेम, आकार, डिस्क इमेज और नेटवर्क सेट होने तक इंस्टेंस बनाएं निष्क्रिय रहता है। डिफ़ॉल्ट नेटवर्क पहले से चुना रहता है, और केवल चुने गए नेटवर्क के फ़ायरवॉल दिखाए जाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buat Instance tetap nonaktif sampai nama host, ukuran, citra disk, dan jaringan ditetapkan. Jaringan default sudah dipilih sebelumnya, dan hanya firewall dari jaringan yang dipilih yang ditawarkan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana bilgisayar adı, boyut, disk imajı ve ağ ayarlanana kadar Sunucu Oluştur devre dışı kalır. Varsayılan ağ önceden seçilidir ve yalnızca seçilen ağın güvenlik duvarları sunulur."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопка Создать экземпляр остается неактивной, пока не заданы имя хоста, размер, образ диска и сеть. Сеть по умолчанию выбрана заранее, и предлагаются только брандмауэры выбранной сети."
          }
        }
      }
    },
