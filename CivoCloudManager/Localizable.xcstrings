    "A progress sheet shows live file counts, byte counters, and the current file being copied." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Fortschrittsfenster zeigt die aktuelle Dateianzahl, Byte-Zähler und die gerade kopierte Datei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A progress sheet shows live file counts, byte counters, and the current file being copied."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una hoja de progreso muestra el conteo de archivos, contadores de bytes y el archivo que se está copiando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une feuille de progression affiche le nombre de fichiers, les compteurs d'octets et le fichier en cours de copie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un foglio di avanzamento mostra il conteggio dei file, i contatori di byte e il file attualmente in copia."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een voortgangsvenster toont het aantal bestanden, byte-tellers en het bestand dat wordt gekopieerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arkusz postępu pokazuje liczbę plików, liczniki bajtów i aktualnie kopiowany plik."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma folha de progresso mostra a contagem de arquivos, contadores de bytes e o arquivo sendo copiado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "进度表显示实时文件数、字节计数器和当前正在复制的文件。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進捗シートには、リアルタイムのファイル数、バイトカウンター、コピー中のファイルが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "진행 시트에는 실시간 파일 개수, 바이트 카운터, 현재 복사 중인 파일이 표시됩니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعرض ورقة التقدم عدد الملفات الحي، وعدادات البايت، والملف الجاري نسخه."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक प्रगति शीट लाइव फ़ाइल गिनती, बाइट काउंटर और वर्तमान कॉपी हो रही फ़ाइल दिखाती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lembar kemajuan menampilkan jumlah file langsung, penghitung byte, dan file yang sedang disalin."
