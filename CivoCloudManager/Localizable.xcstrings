    "After this change the rule admits traffic from every address on the internet." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After this change the rule admits traffic from every address on the internet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dieser Änderung lässt die Regel Datenverkehr von jeder Adresse im Internet zu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras este cambio, la regla admite tráfico de cualquier dirección de internet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après cette modification, la règle autorise le trafic depuis n'importe quelle adresse d'Internet."
