          }
        }
      },
      "extractionState" : "manual"
    },
    "The private key was exported, but its encrypted backup could not be saved. Keep the exported file safe." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The private key was exported, but its encrypted backup could not be saved. Keep the exported file safe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der private Schlüssel wurde exportiert, aber sein verschlüsseltes Backup konnte nicht gespeichert werden. Bewahre die exportierte Datei sicher auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave privada se exportó, pero no se pudo guardar su copia de seguridad cifrada. Guarda el archivo exportado en un lugar seguro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé privée a été exportée, mais sa sauvegarde chiffrée n’a pas pu être enregistrée. Conservez le fichier exporté en lieu sûr."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiave privata è stata esportata, ma non è stato possibile salvare il backup crittografato. Conserva il file esportato in un luogo sicuro."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De privésleutel is geëxporteerd, maar de versleutelde back-up kon niet worden opgeslagen. Bewaar het geëxporteerde bestand veilig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klucz prywatny został wyeksportowany, ale nie udało się zapisać jego zaszyfrowanej kopii zapasowej. Przechowuj wyeksportowany plik w bezpiecznym miejscu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chave privada foi exportada, mas não foi possível guardar a cópia de segurança encriptada. Guarde o ficheiro exportado num local seguro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私钥已导出，但加密备份未能保存。请妥善保管导出文件。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "秘密鍵はエクスポートされましたが、暗号化されたバックアップの保存に失敗しました。エクスポートしたファイルは安全に保管してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개인 키는 내보내졌으나 암호화된 백업을 저장하지 못했습니다. 내보낸 파일을 안전하게 보관하세요."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تصدير المفتاح الخاص، لكن لم يتم حفظ النسخة الاحتياطية المشفرة. احتفظ بالملف المصدر في مكان آمن."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निजी कुंजी निर्यात की गई, लेकिन उसका एन्क्रिप्टेड बैकअप सहेजा नहीं जा सका। निर्यातित फ़ाइल को सुरक्षित रखें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci privat telah diekspor, tetapi cadangan terenkripsinya tidak dapat disimpan. Simpan file ekspor tersebut dengan aman."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Özel anahtar dışa aktarıldı, ancak şifreli yedeği kaydedilemedi. Dışa aktarılan dosyayı güvende tutun."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приватный ключ был экспортирован, но его зашифрованная резервная копия не может быть сохранена. Храните экспортированный файл в безопасности."
          }
        }
      }
    },
