    "Without a public IP address, the instance is reachable only inside its network, and the detail view shows no SSH command." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without a public IP address, the instance is reachable only inside its network, and the detail view shows no SSH command."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne öffentliche IP-Adresse ist die Instanz nur innerhalb ihres Netzwerks erreichbar, und die Detailansicht zeigt keinen SSH-Befehl."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin dirección IP pública, la instancia solo es accesible dentro de su red y la vista de detalles no muestra ningún comando SSH."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans adresse IP publique, l'instance n'est joignable qu'à l'intérieur de son réseau, et la vue détaillée n'affiche aucune commande SSH."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza indirizzo IP pubblico, l'istanza è raggiungibile solo all'interno della sua rete e la vista dettagli non mostra alcun comando SSH."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonder openbaar IP-adres is de instantie alleen binnen haar netwerk bereikbaar en toont de detailweergave geen SSH-opdracht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez publicznego adresu IP instancja jest dostępna tylko w swojej sieci, a widok szczegółów nie pokazuje polecenia SSH."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem endereço IP público, a instância só é acessível dentro da sua rede e a vista de detalhes não mostra nenhum comando SSH."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有公网 IP 地址时，实例只能在其网络内访问，详情视图也不会显示 SSH 命令。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パブリック IP アドレスがない場合、インスタンスはそのネットワーク内からのみ到達でき、詳細ビューに SSH コマンドは表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공인 IP 주소가 없으면 인스턴스는 해당 네트워크 안에서만 접근할 수 있으며, 상세 보기에 SSH 명령이 표시되지 않습니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدون عنوان IP عام، لا يمكن الوصول إلى المثيل إلا داخل شبكته، ولا يعرض عرض التفاصيل أي أمر SSH."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सार्वजनिक IP पते के बिना इंस्टेंस केवल अपने नेटवर्क के भीतर पहुंच योग्य है, और विवरण दृश्य में कोई SSH कमांड नहीं दिखती।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa alamat IP publik, instance hanya dapat dijangkau di dalam jaringannya, dan tampilan detail tidak menampilkan perintah SSH."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genel IP adresi olmadan sunucuya yalnızca kendi ağı içinden erişilebilir ve ayrıntı görünümü SSH komutu göstermez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без публичного IP-адреса экземпляр доступен только внутри своей сети, а в подробном представлении нет команды SSH."
          }
        }
      }
    },
